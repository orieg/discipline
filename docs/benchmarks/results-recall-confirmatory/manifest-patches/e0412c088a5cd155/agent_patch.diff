@@ -133,3 +133,11 @@
 @dispatch(Rationals, Range)  # type: ignore # noqa:F811
 def is_subset_sets(a, b): # noqa:F811
     return False
+
+@dispatch(ProductSet, Set)  # type: ignore # noqa:F811
+def is_subset_sets(a, b): # noqa:F811
+    # Check if ProductSet is a subset of other set
+    # If ProductSet is finite, we can iterate through its elements
+    if a.is_finite_set is True:
+        return fuzzy_and(b.contains(e) for e in a)
+    return None
