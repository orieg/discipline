+        # Patches use the dash offset in their linestyle.
+        # For patches (closed paths), we normalize the linestyle offset
+        # to be half the pattern sum, as the offset is effectively arbitrary
+        # for closed shapes (the pattern wraps around).
+        offset, dashes = self._dash_pattern
+        if dashes is not None and len(dashes) > 0:
+            pattern_sum = sum(dashes)
+            normalized_offset = pattern_sum / 2
+            if normalized_offset != offset:
+                self._linestyle = (normalized_offset, dashes)
+                self._dash_pattern = (normalized_offset, dashes)
+
+        with self._bind_draw_path_function(renderer) as draw_path:
