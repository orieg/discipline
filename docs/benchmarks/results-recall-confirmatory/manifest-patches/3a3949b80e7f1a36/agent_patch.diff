+class ASTUserDefinedLiteral(ASTLiteral):
+    def __init__(self, base: ASTLiteral, suffix: str) -> None:
+        self.base = base
+        self.suffix = suffix
+
+    def _stringify(self, transform: StringifyTransform) -> str:
+        return str(self.base) + self.suffix
+
+    def get_id(self, version: int) -> str:
+        # Format: clL_Zli<suffix_len>_<suffix>E<base_id>EE
+        suffix_encoded = str(len(self.suffix)) + self.suffix
+        base_id = self.base.get_id(version)
+        return "clL_Zli%sE%sE" % (suffix_encoded, base_id)
+
+    def describe_signature(self, signode: TextElement, mode: str,
+                           env: "BuildEnvironment", symbol: "Symbol") -> None:
+        txt = str(self)
+        signode.append(nodes.Text(txt, txt))
+
