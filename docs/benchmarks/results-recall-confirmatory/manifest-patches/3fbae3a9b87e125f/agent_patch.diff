diff --git a/django/views/debug.py b/django/views/debug.py
--- a/django/views/debug.py
+++ b/django/views/debug.py
@@ -423,7 +423,9 @@
 
         # In case there's just one exception, take the traceback from self.tb
         exc_value = exceptions.pop()
