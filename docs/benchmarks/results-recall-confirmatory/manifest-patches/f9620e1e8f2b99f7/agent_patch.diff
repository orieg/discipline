-        lines = [lines[1]] + lines + [lines[1]]
+        # FixedWidthData.write() outputs: header rows, separator (position_line), data rows
+        # For RST format, we need: separator, header rows, separator, data, separator
+        separator = lines[len(self.header.header_rows)]
+        header_rows = lines[: len(self.header.header_rows)]
+        data_rows = lines[len(self.header.header_rows) + 1 :]
+        lines = [separator] + header_rows + [separator] + data_rows + [separator]
         return lines
