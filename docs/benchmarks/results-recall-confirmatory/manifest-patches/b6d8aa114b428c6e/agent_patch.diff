+def _split_csv_for_regex(value: str) -> list[str]:
+    """Split a comma-separated string of regular expressions.
+
+    This is a regex-aware CSV splitter that handles commas within
+    regex quantifiers like {1,3}.
+
+    Commas inside { } are not treated as separators because they are
+    valid within regex quantifier expressions (e.g., {1,3} means
+    "between 1 and 3 repetitions").
+
+    Commas outside { } (at brace depth 0) are treated as separators
+    between different regex patterns.
+
+    >>> _split_csv_for_regex('foo')
+    ['foo']
+    >>> _split_csv_for_regex('foo,bar')
+    ['foo', 'bar']
+    >>> _split_csv_for_regex('foo, bar{1,3}')
+    ['foo', 'bar{1,3}']
+    >>> _split_csv_for_regex('(foo{1,3})')
+    ['(foo{1,3})']
+    """
+    result: list[str] = []
+    current: list[str] = []
+    depth_braces = 0  # depth of {} nesting
+
+    for char in value:
+        # Track brace depth
+        if char == "{":
+            depth_braces += 1
+        elif char == "}":
+            depth_braces -= 1
+
+        # Only split on comma at brace depth 0
+        if char == "," and depth_braces == 0:
+            result.append("".join(current).strip())
+            current = []
+        else:
+            current.append(char)
+
+    # Add the last element
+    last = "".join(current).strip()
+    if last:
+        result.append(last)
+
+    return result
+
+
