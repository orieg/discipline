+def _split_name_with_digits(name):
+    """Split a name that ends with digits into name and digits parts.
+
+    Returns (name, digits) if the name ends with digits, else None.
+    This is Unicode-aware, handling both ASCII and Unicode letters and digits.
+    """
+    if not name:
+        return None
+
+    # Find the index where letters end
+    i = 0
+    while i < len(name) and name[i].isalpha():
+        i += 1
+
+    # If we haven't found any letters or reached the end, no split
+    if i == 0 or i == len(name):
+        return None
+
+    # Check if the rest is all digits
+    rest = name[i:]
+    if all(c.isdigit() for c in rest):
+        return (name[:i], rest)
+
+    return None
 
 
