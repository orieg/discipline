     from sphinx.directive import ObjectDescription
 
 
+def _split_arg_type(fieldarg: str) -> Tuple[str, str]:
+    """Split *fieldarg* into type and name, respecting brackets and parentheses.
+
+    For example:
+    - "Dict[str, str] params" -> ("Dict[str, str]", "params")
+    - "dict(str, str) opc_meta" -> ("dict(str, str)", "opc_meta")
+    """
+    bracket_depth = 0
+    for i, char in enumerate(fieldarg):
+        if char in '([{':
+            bracket_depth += 1
+        elif char in ')]}':
+            bracket_depth -= 1
+        elif char.isspace() and bracket_depth == 0:
+            return fieldarg[:i].strip(), fieldarg[i + 1:].strip()
+
+    raise ValueError("No valid split found")
+
