diff --git a/astropy/io/fits/card.py b/astropy/io/fits/card.py
--- a/astropy/io/fits/card.py
+++ b/astropy/io/fits/card.py
@@ -1299,20 +1299,34 @@
 
 def _format_float(value):
     """Format a floating number to make sure it gets the decimal point."""
-    value_str = f"{value:.16G}"
-    if "." not in value_str and "E" not in value_str:
-        value_str += ".0"
-    elif "E" in value_str:
-        # On some Windows builds of Python (and possibly other platforms?) the
-        # exponent is zero-padded out to, it seems, three digits.  Normalize
-        # the format to pad only to two digits.
-        significand, exponent = value_str.split("E")
-        if exponent[0] in ("+", "-"):
-            sign = exponent[0]
-            exponent = exponent[1:]
-        else:
-            sign = ""
-        value_str = f"{significand}E{sign}{int(exponent):02d}"
+    # First try using str(value) which gives the shortest unique representation
+    # This avoids unnecessary precision like 0.009124999999999999 for 0.009125
+    value_str = str(value)
+
+    # Check if we need to ensure decimal point or uppercase E
+    needs_fix = False
+
+    if "E" not in value_str.upper():
+        # No exponent, check for decimal point
+        if "." not in value_str:
+            value_str += ".0"
+            needs_fix = True
+    else:
+        # Has exponent, need to normalize to uppercase E and 2-digit exponent
+        needs_fix = True
+
+    if needs_fix:
+        # Normalize the format
+        if "e" in value_str.lower():
+            # Split on E/e
+            significand, exponent = value_str.lower().split("e")
+            # Ensure uppercase E
+            if exponent[0] in ("+", "-"):
+                sign = exponent[0]
+                exponent = exponent[1:]
+            else:
+                sign = ""
+            value_str = f"{significand}E{sign}{int(exponent):02d}"
 
     # Limit the value string to at most 20 characters.
     str_len = len(value_str)
