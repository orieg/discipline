+def _split_argtype_argname(fieldarg: str) -> Tuple[str, str]:
+    """Split the field argument into argtype and argname.
+    
+    This function handles type annotations that may contain spaces inside
+    brackets/parens (e.g., "Dict[str, str] param_name" or "dict(str, str) param_name").
+    
+    Returns:
+        A tuple of (argtype, argname) if successful, or (None, None) if not.
+    """
+    brackets = {'(': ')', '[': ']', '{': '}'}
+    depth = 0
+    for i, char in enumerate(fieldarg):
+        if char in brackets:
+            depth += 1
+        elif char in brackets.values():
+            depth -= 1
+        elif char.isspace() and depth == 0:
+            # Found whitespace outside of brackets
+            argname = fieldarg[i + 1:].lstrip()
+            if argname:
+                return fieldarg[:i].rstrip(), argname
+    
+    return None, None
+
