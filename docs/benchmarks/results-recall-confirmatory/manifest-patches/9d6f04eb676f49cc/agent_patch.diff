diff --git a/django/utils/autoreload.py b/django/utils/autoreload.py
--- a/django/utils/autoreload.py
+++ b/django/utils/autoreload.py
@@ -223,8 +223,16 @@
     # __spec__ is set when the server was started with the `-m` option,
     # see https://docs.python.org/3/reference/import.html#main-spec
     # __spec__ may not exist, e.g. when running in a Conda env.
-    if getattr(__main__, '__spec__', None) is not None and __main__.__spec__.parent:
-        args += ['-m', __main__.__spec__.parent]
+    if getattr(__main__, '__spec__', None) is not None:
+        # When running with -m, the __main__ module's __spec__ is set.
+        # __main__.__spec__.name includes __main__ for packages (e.g., 'django.__main__'),
+        # but we want the top-level package name ('django') to be used with -m.
+        # For non-package modules (e.g., 'foo.bar.baz'), we use the full name.
+        spec_name = __main__.__spec__.name
+        if spec_name.endswith('.__main__'):
+            args += ['-m', __main__.__spec__.parent]
+        else:
+            args += ['-m', spec_name]
         args += sys.argv[1:]
     elif not py_script.exists():
         # sys.argv[0] may not exist for several reasons on Windows.
