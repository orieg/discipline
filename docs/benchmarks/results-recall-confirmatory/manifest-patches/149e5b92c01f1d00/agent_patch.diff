 from django.conf import settings
 from django.contrib.messages import constants, utils
 
-LEVEL_TAGS = utils.get_level_tags()
+
+class LevelTags(dict):
+    """
+    A dict subclass that provides dynamic level tags based on settings.
+
+    This ensures LEVEL_TAGS is always up-to-date with the current MESSAGE_TAGS
+    setting, which is important when using @override_settings in tests.
+    """
+    def _get_level_tags(self):
+        return utils.get_level_tags()
+
+    def __getitem__(self, key):
+        return self._get_level_tags()[key]
+
+    def get(self, key, default=None):
+        return self._get_level_tags().get(key, default)
+
+    def __iter__(self):
+        return iter(self._get_level_tags())
+
+    def __len__(self):
+        return len(self._get_level_tags())
+
+    def __contains__(self, key):
+        return key in self._get_level_tags()
+
+    def __eq__(self, other):
+        if not isinstance(other, dict):
+            return NotImplemented
+        if len(self) != len(other):
+            return False
+        for key in self:
+            if other.get(key) != self.get(key):
+                return False
+        return True
+
+    def __repr__(self):
+        return repr({key: self[key] for key in self})
+
+
+LEVEL_TAGS = LevelTags()
 
 
