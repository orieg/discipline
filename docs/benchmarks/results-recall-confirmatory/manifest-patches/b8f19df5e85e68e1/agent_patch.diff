+
+        if center:
+            # For center=True, the window is centered around the current position.
+            # For window size w, the window spans [i - w//2, i + (w-1) - w//2]
+            half = window // 2
+            starts = np.arange(len(self.window_labels)) - half
+            stops = starts + window
+        else:
+            # For center=False (left-justified), the window ends at the current position.
+            # For window size w, the window spans [i - w + 1, i]
+            starts = np.arange(len(self.window_labels)) - window + 1
+            stops = np.arange(len(self.window_labels)) + 1
+
+        starts = np.maximum(0, starts)
+        stops = np.minimum(len(self.window_labels), stops)
