     from sphinx.directive import ObjectDescription
 
 
+def _split_argtype_and_name(fieldarg: str) -> Tuple[str, str]:
+    """Split a field argument into type and name.
+
+    Splits on whitespace, but respects parentheses and brackets
+    so that types like ``dict(str, str) opc_meta`` are correctly parsed.
+    Returns (argtype, argname) or raises ValueError if not splittable.
+    """
+    depth_paren = 0
+    depth_bracket = 0
+    parts: List[str] = []
+    current: List[str] = []
+
+    for char in fieldarg:
+        if char == '(':
+            depth_paren += 1
+            current.append(char)
+        elif char == ')':
+            depth_paren -= 1
+            current.append(char)
+        elif char == '[':
+            depth_bracket += 1
+            current.append(char)
+        elif char == ']':
+            depth_bracket -= 1
+            current.append(char)
+        elif char == ' ' and depth_paren == 0 and depth_bracket == 0:
+            if current:
+                parts.append(''.join(current))
+                current = []
+        else:
+            current.append(char)
+
+    if current:
+        parts.append(''.join(current))
+
+    if len(parts) != 2:
+        raise ValueError(f"Cannot split into exactly two parts: {fieldarg!r}")
+
+    return parts[0], parts[1]
+
