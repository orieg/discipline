diff --git a/sympy/sets/handlers/comparison.py b/sympy/sets/handlers/comparison.py
--- a/sympy/sets/handlers/comparison.py
+++ b/sympy/sets/handlers/comparison.py
@@ -49,6 +49,33 @@
     return tfn[fuzzy_and(map(fuzzy_bool, eqs))]
 
 
+@dispatch(ProductSet, FiniteSet) # type:ignore
+def _eval_is_eq(lhs, rhs): # noqa: F811
+    # If ProductSet is not finite, it can't be equal to a FiniteSet
+    if lhs.is_finite_set is False:
+        return False
+    # Check if all elements of the ProductSet are in the FiniteSet and vice versa
+    if not fuzzy_and(fuzzy_bool(rhs.contains(t)) for t in lhs):
+        return False
+    return fuzzy_and(fuzzy_bool(lhs.contains(t)) for t in rhs)
+
+
+@dispatch(FiniteSet, ProductSet) # type:ignore
+def _eval_is_eq(lhs, rhs): # noqa: F811
+    return _eval_is_eq(rhs, lhs)
+
+
+@dispatch(ProductSet, Interval) # type:ignore
+def _eval_is_eq(lhs, rhs): # noqa: F811
+    # ProductSet is multi-dimensional, Interval is 1D, so they can't be equal
+    return False
+
+
+@dispatch(Interval, ProductSet) # type:ignore
+def _eval_is_eq(lhs, rhs): # noqa: F811
+    return _eval_is_eq(rhs, lhs)
+
+
 @dispatch(Set, Basic) # type:ignore
 def _eval_is_eq(lhs, rhs): # noqa: F811
     return False
