@@ -133,3 +133,14 @@
 @dispatch(Rationals, Range)  # type: ignore # noqa:F811
 def is_subset_sets(a, b): # noqa:F811
     return False
+
+@dispatch(ProductSet, FiniteSet)  # type: ignore # noqa:F811
+def is_subset_sets(a, b): # noqa:F811
+    # If ProductSet is empty, it's always a subset
+    if a.is_empty:
+        return True
+    # If ProductSet is not finite, it can't be a subset of a finite set
+    if a.is_finite_set is False:
+        return False
+    # Check if all elements of the ProductSet are in the FiniteSet
+    return fuzzy_and(fuzzy_bool(b.contains(t)) for t in a)
