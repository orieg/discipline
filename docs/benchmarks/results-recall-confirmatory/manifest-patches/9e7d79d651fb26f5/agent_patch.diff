+def _splitstrip_regex(string: str) -> list[str]:
+    """Split a comma-separated string on commas, but respect curly braces.
+
+    This is needed for parsing comma-separated regular expressions that may
+    contain commas inside quantifier expressions like {1,3}.
+
+    >>> _splitstrip_regex('a, b, c')
+    ['a', 'b', 'c']
+    >>> _splitstrip_regex('foo, bar{1,3}')
+    ['foo', 'bar{1,3}']
+    >>> _splitstrip_regex('(foo{1,3})')
+    ['(foo{1,3})']
+
+    :param string: a csv line potentially containing regular expressions
+    :return: the split and stripped strings
+    """
+    result: list[str] = []
+    current: list[str] = []
+    brace_count = 0
+
+    for char in string:
+        if char == "{":
+            brace_count += 1
+            current.append(char)
+        elif char == "}":
+            brace_count -= 1
+            current.append(char)
+        elif char == "," and brace_count == 0:
+            if current:
+                result.append("".join(current).strip())
+                current = []
+        else:
+            current.append(char)
+
+    if current:
+        result.append("".join(current).strip())
+
+    return result
+
