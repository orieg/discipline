+def _verify_session_hash(session_hash, user, session):
+    """
+    Verify the session hash against the user's password hash using the current
+    secret key and fallback keys.
+
+    If a fallback key matches, update the session hash to use the current
+    secret key.
+
+    Return True if the session hash matches any of the keys.
+    """
+    key_salt = (
+        "django.contrib.auth.models.AbstractBaseUser.get_session_auth_hash"
+    )
+    for i, secret in enumerate([settings.SECRET_KEY, *settings.SECRET_KEY_FALLBACKS]):
+        expected_hash = salted_hmac(
+            key_salt, user.password, secret=secret, algorithm="sha256"
+        ).hexdigest()
+        if constant_time_compare(session_hash, expected_hash):
+            # If a fallback key matched (i > 0), update the session hash
+            # to use the current secret key.
+            if i > 0:
+                session[HASH_SESSION_KEY] = salted_hmac(
+                    key_salt, user.password, secret=settings.SECRET_KEY, algorithm="sha256"
+                ).hexdigest()
+            return True
+    return False
+
