diff --git a/sphinx/ext/autodoc/mock.py b/sphinx/ext/autodoc/mock.py
--- a/sphinx/ext/autodoc/mock.py
+++ b/sphinx/ext/autodoc/mock.py
@@ -52,8 +52,16 @@
     def __mro_entries__(self, bases: Tuple) -> Tuple:
         return (self.__class__,)
 
-    def __getitem__(self, key: str) -> "_MockObject":
-        return _make_subclass(key, self.__display_name__, self.__class__)()
+    def __getitem__(self, key: Any) -> "_MockObject":
+        if isinstance(key, str):
+            return _make_subclass(key, self.__display_name__, self.__class__)()
+        else:
+            # For non-string keys (TypeVar, etc.), create a class that
+            # preserves the mock nature without string concatenation
+            attrs = {"__module__": self.__module__,
+                    "__display_name__": self.__display_name__,
+                    "__sphinx_mock__": True}
+            return type(self.__display_name__, (self.__class__,), attrs)()
 
     def __getattr__(self, key: str) -> "_MockObject":
         return _make_subclass(key, self.__display_name__, self.__class__)()
