+def _extract_arg_and_type(fieldarg: str) -> Tuple[str, str]:
+    """
+    Extract parameter name and type annotation from a field argument.
+    
+    Examples:
+        'params' -> ('params', '')
+        'Dict[str, str] params' -> ('params', 'Dict[str, str]')
+        'dict(str, str) opc_meta' -> ('opc_meta', 'dict(str, str)')
+        'List[int] items' -> ('items', 'List[int]')
+        'str name' -> ('name', 'str')
+        'int age' -> ('age', 'int')
+    """
+    fieldarg = fieldarg.strip()
+    
+    # Find the first bracket or parenthesis
+    bracket_start = None
+    paren_start = None
+    
+    for i, c in enumerate(fieldarg):
+        if c == '[':
+            bracket_start = i
+            break
+        elif c == '(':
+            paren_start = i
+            break
+    
+    if bracket_start is not None:
+        # Find matching ]
+        depth = 0
+        for i in range(bracket_start, len(fieldarg)):
+            if fieldarg[i] == '[':
+                depth += 1
+            elif fieldarg[i] == ']':
+                depth -= 1
+                if depth == 0:
+                    bracket_end = i
+                    break
+        if depth == 0:
+            type_part = fieldarg[:bracket_end + 1]
+            name_part = fieldarg[bracket_end + 1:].strip()
+            return name_part, type_part
+    elif paren_start is not None:
+        # Find matching )
+        depth = 0
+        for i in range(paren_start, len(fieldarg)):
+            if fieldarg[i] == '(':
+                depth += 1
+            elif fieldarg[i] == ')':
+                depth -= 1
+                if depth == 0:
+                    paren_end = i
+                    break
+        if depth == 0:
+            type_part = fieldarg[:paren_end + 1]
+            name_part = fieldarg[paren_end + 1:].strip()
+            return name_part, type_part
+    else:
+        # No brackets or parens - try to split on whitespace
+        # to get "type name" pattern
+        parts = fieldarg.split(None, 1)
+        if len(parts) == 2:
+            return parts[1], parts[0]
+    
+    return fieldarg, ''
+
