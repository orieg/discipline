+def _split_name_with_digits(name):
+    """Split a name into name and trailing digits.
+
+    This is similar to _name_with_digits_p regex but uses Unicode-aware
+    methods to handle non-ASCII letters and digits.
+
+    Returns (name, digits) if name consists of only letters followed by
+    digits, otherwise returns (None, None).
+    """
+    i = 0
+    for c in name:
+        if c.isalpha():
+            i += 1
+        else:
+            break
+
+    name_part = name[:i]
+    digits_part = name[i:]
+
+    if name_part and digits_part and digits_part.isdigit():
+        return name_part, digits_part
+    return None, None
 
 
