+def _verify_session_hash(user, session_hash, request):
+    """
+    Verify the session hash against the current secret and fallback secrets.
+
+    Returns True if the session hash is valid.
+    If verified with a fallback secret, updates the session hash with the
+    current secret and cycles the session key.
+    """
+    from django.conf import settings
+
+    # First, try with the current secret (default)
+    if constant_time_compare(session_hash, user.get_session_auth_hash()):
+        return True
+
+    # Try with fallback secrets
+    if hasattr(settings, "SECRET_KEY_FALLBACKS"):
+        for fallback_secret in settings.SECRET_KEY_FALLBACKS:
+            if constant_time_compare(
+                session_hash, user.get_session_auth_hash(secret=fallback_secret)
+            ):
+                # Update the session hash and cycle the session key.
+                # Cycling the session key is important for security when a
+                # fallback secret is used - it invalidates the old session.
+                request.session.cycle_key()
+                request.session[HASH_SESSION_KEY] = user.get_session_auth_hash()
+                return True
+
+    return False
+
