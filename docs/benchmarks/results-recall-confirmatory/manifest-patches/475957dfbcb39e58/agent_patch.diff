+    def _get_ancestor_pk_path(self, query, ancestor_model):
+        """
+        Get the path to select an ancestor model's PK from the query's model.
+        Returns a list of field names for use with add_fields().
+        """
+        model = query.model
+        # Find the path from the current model to the ancestor
+        # by traversing the inheritance chain
+        if ancestor_model not in model._meta.get_parent_list():
+            return []
+        # Get the base chain from current model to ancestor
+        base_chain = model._meta.get_base_chain(ancestor_model)
+        if not base_chain:
+            return []
+        # Get the link fields along the chain
+        link_fields = []
+        current_opts = model._meta
+        for parent_model in base_chain:
+            link_field = current_opts.parents.get(parent_model)
+            if link_field is None:
+                link_field = current_opts.get_ancestor_link(parent_model)
+            if link_field:
+                link_fields.append(link_field.name)
+                current_opts = parent_model._meta
+        # Append the ancestor's PK field name
+        link_fields.append(ancestor_model._meta.pk.name)
+        return link_fields
