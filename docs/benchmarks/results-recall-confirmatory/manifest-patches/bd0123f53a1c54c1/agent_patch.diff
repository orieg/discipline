+    def _get_udl_suffix(self) -> Optional[str]:
+        """Get user-defined literal suffix if present.
+
+        A UDL suffix is an identifier-like sequence that is NOT purely
+        type modifiers (u, U, l, L, f, F).
+        """
+        # Match identifier-like characters
+        if not self.match(identifier_re):
+            return None
+        suffix = self.matched_text
+        # Check if it's purely type modifiers (not a valid UDL suffix)
+        type_modifiers = set('uUlLfF')
+        if all(c in type_modifiers for c in suffix):
+            return None
+        return suffix
