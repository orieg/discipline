+    def _FK_models_are_equal(self, old_remote_field, new_remote_field):
+        """
+        Compare two remote fields to see if they point to the same model.
+        Handles the case where one or both models are strings or SettingsReference.
+        """
+        old_model = old_remote_field.model
+        new_model = new_remote_field.model
+        # If both are model classes, compare their app_label and model_name
+        if not isinstance(old_model, str) and not isinstance(new_model, str):
+            return (
+                old_model._meta.app_label == new_model._meta.app_label and
+                old_model._meta.model_name == new_model._meta.model_name
+            )
+        # If either is a string (including SettingsReference), compare as strings
+        return str(old_model) == str(new_model)
+
     def _get_dependencies_for_foreign_key(self, field):
