+def _check_csv_regex(value: list[str] | tuple[str] | str) -> Sequence[str]:
+    """Transforms a comma separated string into a list of strings.
+
+    This function is similar to _check_csv but respects commas inside
+    curly braces (e.g., regex quantifiers like {1,3}).
+    """
+    if isinstance(value, (list, tuple)):
+        return value
+    result: list[str] = []
+    current: list[str] = []
+    brace_count = 0
+    for char in value:
+        if char == "{":
+            brace_count += 1
+            current.append(char)
+        elif char == "}":
+            brace_count -= 1
+            current.append(char)
+        elif char == "," and brace_count == 0:
+            # Only split on commas that are not inside braces
+            if current:
+                result.append("".join(current).strip())
+                current = []
+        else:
+            current.append(char)
+    if current:
+        result.append("".join(current).strip())
+    return [s for s in result if s]
+
