+def _get_dividers(extend):
+    """
+    Return the slice of mesh rows to use for colorbar divider lines.
+
+    Parameters
+    ----------
+    extend : {'neither', 'min', 'max', 'both'}
+        The colorbar extension type.
+
+    Returns
+    -------
+    slice
+        The slice to select the appropriate mesh rows for divider lines.
+    """
+    # The slice determines which mesh rows to use for drawing divider lines.
+    # - 'neither': no extensions, draw dividers at interior boundaries only
+    # - 'min': extend at minimum, draw dividers from start to second-to-last
+    # - 'max': extend at maximum, draw dividers from second row to end
+    # - 'both': extend at both ends, draw all dividers
+    if extend == 'neither':
+        return slice(1, -1, None)
+    elif extend == 'min':
+        return slice(0, -1, None)
+    elif extend == 'max':
+        return slice(1, None, None)
+    elif extend == 'both':
+        return slice(None, None, None)
+    else:
+        # Default to neither behavior for unknown extend values
+        return slice(1, -1, None)
+
