+@dispatch(ProductSet, FiniteSet)  # type: ignore # noqa:F811
+def is_subset_sets(a_productset, b_finiteset): # noqa:F811
+    # A ProductSet is a subset of a FiniteSet if:
+    # - All elements of the ProductSet are in the FiniteSet
+    # - The ProductSet must be finite and iterable
+    if a_productset.is_empty:
+        return True
+    if a_productset.is_finite_set is False:
+        return False
+    if a_productset.is_iterable:
+        return fuzzy_and(b_finiteset.contains(x) for x in a_productset)
+    return None
