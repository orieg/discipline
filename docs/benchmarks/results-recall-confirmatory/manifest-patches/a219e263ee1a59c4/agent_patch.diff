+        # = 1 + len(header_rows) + 1 = len(header_rows) + 2
+        self.data.start_line = len(self.data.header_rows) + 2
 
     def write(self, lines):
         lines = super().write(lines)
-        lines = [lines[1]] + lines + [lines[1]]
+        # The position line is at index len(header_rows) in the lines list
+        # since FixedWidthData.write() adds header_rows first, then position_line
+        header_rows = getattr(self.data, "header_rows", ["name"])
+        pos_line_idx = len(header_rows)
+        lines = [lines[pos_line_idx]] + lines + [lines[pos_line_idx]]
         return lines
