+def _check_csv_regex(value: list[str] | tuple[str] | str) -> Sequence[str]:
+    """Return a list of stripped strings by splitting on commas, but not inside
+    curly braces (which are used for regex quantifiers like {1,3}).
+
+    Empty strings are discarded.
+
+    >>> _check_csv_regex('foo, bar{1,3}, baz')
+    ['foo', 'bar{1,3}', 'baz']
+    >>> _check_csv_regex('foo{1,}, bar')
+    ['foo{1,}', 'bar']
+    >>> _check_csv_regex('foo')
+    ['foo']
+    """
+    if isinstance(value, (list, tuple)):
+        return value
+
+    result: list[str] = []
+    current: list[str] = []
+    brace_depth = 0
+
+    for char in value:
+        if char == "{":
+            brace_depth += 1
+            current.append(char)
+        elif char == "}":
+            brace_depth -= 1
+            current.append(char)
+        elif char == "," and brace_depth == 0:
+            result.append("".join(current).strip())
+            current = []
+        else:
+            current.append(char)
+
+    # Add the last element
+    if current or value.endswith(","):
+        result.append("".join(current).strip())
+
+    # Filter out empty strings
+    return [item for item in result if item]
+
+
