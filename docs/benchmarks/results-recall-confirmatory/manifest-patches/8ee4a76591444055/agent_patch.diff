diff --git a/django/contrib/admindocs/utils.py b/django/contrib/admindocs/utils.py
--- a/django/contrib/admindocs/utils.py
+++ b/django/contrib/admindocs/utils.py
@@ -34,7 +34,11 @@
         return ''
     # Convert tabs to spaces and split into lines
     lines = docstring.expandtabs().splitlines()
-    indent = min(len(line) - len(line.lstrip()) for line in lines if line.lstrip())
+    # Determine common indentation by checking lines after the first line.
+    # Skip the first line because it might not have any indentation (e.g.,
+    # '"""first line"""') which would incorrectly set indent to 0.
+    indents = [len(line) - len(line.lstrip()) for line in lines[1:] if line.lstrip()]
+    indent = min(indents) if indents else 0
     trimmed = [lines[0].lstrip()] + [line[indent:].rstrip() for line in lines[1:]]
     return "\n".join(trimmed).strip()
 
