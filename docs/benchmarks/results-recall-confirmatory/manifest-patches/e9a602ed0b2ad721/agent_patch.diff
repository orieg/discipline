+    """Format a floating number to make sure it gets the decimal point.
+
+    This function tries to use the shortest possible string representation
+    of the float value that still round-trips correctly. It first attempts
+    to use Python's default ``str(value)`` representation, which is usually
+    the shortest. Only if that is longer than 20 characters or doesn't have
+    a decimal point/exponent notation does it fall back to the ``.16G``
+    format.
+    """
+    # Try str() first - it gives the shortest representation that round-trips.
+    # This avoids unnecessarily long representations like "0.009124999999999999"
+    # for values like 0.009125.
+    value_str = str(value)
+
+    # Special float values like inf, -inf, nan don't have decimal points
+    # but are valid FITS values and shouldn't have .0 added.
+    special_values = (
+        "inf",
+        "-inf",
+        "nan",
+        "-nan",
+        "Inf",
+        "-Inf",
+        "NaN",
+        "-NaN",
+        "INF",
+        "-INF",
+        "NAN",
+        "-NAN",
+    )
+    if value_str not in special_values:
+        # Ensure the string has a decimal point or exponent notation (FITS requirement).
+        if "." not in value_str and "E" not in value_str and "e" not in value_str:
+            value_str += ".0"
+
+        # Normalize exponent format to use uppercase E and pad to 2 digits.
+        if "e" in value_str and "E" not in value_str:
+            value_str = value_str.replace("e", "E", 1)
+            idx = value_str.find("E")
+            significand = value_str[:idx]
+            exponent_str = value_str[idx + 1 :]
+            if exponent_str[0] in ("+", "-"):
+                sign = exponent_str[0]
+                exp_digits = exponent_str[1:]
+            else:
+                sign = ""
+                exp_digits = exponent_str
+            value_str = f"{significand}E{sign}{int(exp_digits):02d}"
+
+    # If str() representation is too long, fall back to .16G format.
+    if len(value_str) > 20:
+        value_str = f"{value:.16G}"
+        if "." not in value_str and "E" not in value_str:
+            value_str += ".0"
+        elif "e" in value_str and "E" not in value_str:
+            value_str = value_str.replace("e", "E", 1)
+            idx = value_str.find("E")
+            significand = value_str[:idx]
+            exponent_str = value_str[idx + 1 :]
+            if exponent_str[0] in ("+", "-"):
+                sign = exponent_str[0]
+                exp_digits = exponent_str[1:]
+            else:
+                sign = ""
+                exp_digits = exponent_str
+            value_str = f"{significand}E{sign}{int(exp_digits):02d}"
 
     # Limit the value string to at most 20 characters.
