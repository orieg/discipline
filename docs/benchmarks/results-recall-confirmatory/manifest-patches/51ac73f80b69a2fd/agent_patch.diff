diff --git a/django/utils/timezone.py b/django/utils/timezone.py
--- a/django/utils/timezone.py
+++ b/django/utils/timezone.py
@@ -73,7 +73,29 @@
 
 def _get_timezone_name(timezone):
     """Return the name of ``timezone``."""
-    return str(timezone)
+    tzname = str(timezone)
+    # For pytz and zoneinfo timezones, we need to handle Etc/GMT* timezones
+    # specially because they use an inverted sign convention.
+    # E.g., Etc/GMT-10 is actually UTC+10:00.
+    # For datetime.timezone objects, we preserve the name as-is.
+    if tzname.startswith('Etc/GMT'):
+        # Check if this is a datetime.timezone object (which preserves custom names)
+        # vs pytz/zoneinfo objects (where we need to return the offset)
+        if type(timezone).__name__ != 'timezone' or type(timezone).__module__ != 'datetime':
+            # For pytz/zoneinfo, extract and invert the sign
+            # E.g., Etc/GMT-10 -> +10, Etc/GMT+10 -> -10
+            # Etc/GMT (no number) -> 0
+            match = _get_tzname_re.match(tzname)
+            if match:
+                sign = '-' if match.group(1) == '+' else '+'
+                hours = match.group(2)
+                tzname = sign + (hours or '0')
+    return tzname
+
+
+# Cached regex pattern for matching Etc/GMT timezone names
+import re
+_get_tzname_re = re.compile(r'^Etc/GMT([+-]?\d*)$')
 
 # Timezone selection functions.
 
