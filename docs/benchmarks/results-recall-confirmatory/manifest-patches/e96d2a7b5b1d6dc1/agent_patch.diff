+            instance = Model(**data)
+            # For FK fields, the related object might need to be prefetched
+            # to avoid database queries going to the wrong database.
+            # We set the _state.db to the target database so any queries
+            # go to the right place.
+            from django.db.models.options import Options
+            instance._state.db = db
+            natural_key = instance.natural_key()
+        except Exception:
+            # If we can't build the natural key (e.g., FK lookup fails),
+            # the model will be created without a pk and saved normally
             pass
+        else:
+            try:
+                data[Model._meta.pk.attname] = Model._meta.pk.to_python(
+                    default_manager.db_manager(db).get_by_natural_key(*natural_key).pk
