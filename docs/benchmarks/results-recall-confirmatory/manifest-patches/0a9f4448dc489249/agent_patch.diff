+def _parse_annotation_for_field(annotation: str) -> Tuple[str, str]:
+    """Parse a field annotation to extract type and parameter name.
+
+    This function handles type annotations that may contain brackets,
+    such as Dict[str, str] or List[int].
+
+    Returns a tuple of (type, name) or (None, None) if parsing fails.
+    """
+    # Track bracket depth to find the first whitespace outside brackets
+    bracket_depth = 0
+    for i, char in enumerate(annotation):
+        if char in '([{':
+            bracket_depth += 1
+        elif char in ')]}':
+            bracket_depth -= 1
+        elif char.isspace() and bracket_depth == 0:
+            # Found the first whitespace outside brackets
+            # Check if there's more content after (the parameter name)
+            remainder = annotation[i + 1:].strip()
+            if remainder:
+                return annotation[:i].strip(), remainder
+
+    # No valid split point found
+    return None, None
+
