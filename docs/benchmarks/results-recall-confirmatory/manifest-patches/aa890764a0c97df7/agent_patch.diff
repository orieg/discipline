diff --git a/lib/matplotlib/figure.py b/lib/matplotlib/figure.py
--- a/lib/matplotlib/figure.py
+++ b/lib/matplotlib/figure.py
@@ -3036,6 +3036,10 @@
         version = state.pop('__mpl_version__')
         restore_to_pylab = state.pop('_restore_to_pylab', False)
 
+        # Save _original_dpi before creating canvas (which resets it).
+        # See https://github.com/matplotlib/matplotlib/issues/22196
+        original_dpi = state.pop('_original_dpi', None)
+
         if version != mpl.__version__:
             _api.warn_external(
                 f"This figure was saved with matplotlib version {version} and "
@@ -3046,6 +3050,17 @@
         # re-initialise some of the unstored state information
         FigureCanvasBase(self)  # Set self.canvas.
 
+        # Restore _original_dpi if it was saved.
+        if original_dpi is not None:
+            self._original_dpi = original_dpi
+            # Reset dpi to _original_dpi since the new canvas starts with
+            # device_pixel_ratio=1.
+            if self._dpi != original_dpi:
+                self._dpi = original_dpi
+                self.dpi_scale_trans.clear().scale(original_dpi)
+                w, h = self.get_size_inches()
+                self.set_size_inches(w, h)
+
         if restore_to_pylab:
             # lazy import to avoid circularity
             import matplotlib.pyplot as plt
