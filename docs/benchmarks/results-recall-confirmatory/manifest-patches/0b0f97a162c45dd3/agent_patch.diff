+    # Try using str() first, which gives the shortest representation
+    # that round-trips correctly. Only use the more verbose .16G format
+    # if str() produces a string that's too long for FITS (20 chars).
+    value_str = str(value)
+
+    if len(value_str) <= 20:
+        # Ensure there's a decimal point or exponent (FITS requirement)
+        if "." not in value_str and "E" not in value_str and "e" not in value_str:
+            value_str += ".0"
+        # Normalize lowercase e to uppercase E and ensure 2-digit exponent
+        elif "e" in value_str:
+            significand, exponent = value_str.split("e")
+            if exponent[0] in ("+", "-"):
+                sign = exponent[0]
+                exponent = exponent[1:]
+            else:
+                sign = ""
+            value_str = f"{significand}E{sign}{int(exponent):02d}"
+    else:
+        # str() is too long, use .16G format
+        value_str = f"{value:.16G}"
+        if "." not in value_str and "E" not in value_str:
+            value_str += ".0"
+        elif "E" in value_str:
+            # On some Windows builds of Python (and possibly other platforms?) the
