 from django.conf import settings
 from django.contrib.messages import constants, utils
 
-LEVEL_TAGS = utils.get_level_tags()
+
+class LevelTags:
+    """
+    Lazy level tags dictionary that always reads the current MESSAGE_TAGS
+    setting.
+    """
+    def __getitem__(self, key):
+        return self._get_level_tags().get(key, '')
+
+    def get(self, key, default=None):
+        return self._get_level_tags().get(key, default)
+
+    def _get_level_tags(self):
+        return utils.get_level_tags()
+
+    def __iter__(self):
+        return iter(self._get_level_tags())
+
+    def __len__(self):
+        return len(self._get_level_tags())
+
+    def __contains__(self, key):
+        return key in self._get_level_tags()
+
+    def __repr__(self):
+        return repr(self._get_level_tags())
+
+    def __eq__(self, other):
+        return self._get_level_tags() == other
+
+    def keys(self):
+        return self._get_level_tags().keys()
+
+    def values(self):
+        return self._get_level_tags().values()
+
+    def items(self):
+        return self._get_level_tags().items()
+
+
+LEVEL_TAGS = LevelTags()
 
 
