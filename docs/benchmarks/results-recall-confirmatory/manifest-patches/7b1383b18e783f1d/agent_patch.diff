+    @property
+    def _iterable_class(self):
+        # If the query has a custom iterable class (e.g., from values() or
+        # values_list()), use it. This ensures that pickled queries with
+        # values() or values_list() work correctly.
+        query_iterable_class = getattr(self._query, '_iterable_class', None)
+        if query_iterable_class is not None:
+            return query_iterable_class
+        return self.__dict__['_iterable_class']
+
+    @_iterable_class.setter
+    def _iterable_class(self, value):
+        self.__dict__['_iterable_class'] = value
