+def _find_unescaped_end(escaped, unescaped_len):
+    """
+    Find the position in an escaped string that corresponds to unescaped_len
+    characters in its unescaped form.
+
+    This is needed because HTML entities (e.g., &lt;, &#60;, &#x3c;) have
+    different lengths when escaped vs unescaped.
+    """
+    i = 0
+    unescaped_count = 0
+    while i < len(escaped) and unescaped_count < unescaped_len:
+        if escaped[i] == '&':
+            # Try to match an HTML entity (with or without semicolon)
+            rest = escaped[i:]
+            m = re.match(r'&#[0-9]+;?|&#[xX][0-9a-fA-F]+;?|&[a-zA-Z]+;?', rest)
+            if m:
+                entity = m.group()
+                unescaped_entity = html.unescape(entity)
+                if unescaped_entity and unescaped_entity[0] != '&':
+                    unescaped_count += len(unescaped_entity)
+                    i += len(entity)
+                    continue
+        unescaped_count += 1
+        i += 1
+    return i
+
