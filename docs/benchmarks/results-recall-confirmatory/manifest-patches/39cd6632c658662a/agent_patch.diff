+    def _parse_ud_suffix(self) -> str:
+        """Parse a user-defined literal suffix if present.
+        
+        Returns the suffix string if found, None otherwise.
+        A ud-suffix is an identifier that can start with a letter or underscore,
+        followed by any number of letters, digits, or underscores.
+        """
+        self.skip_ws()
+        # Match ud-suffix: must start with letter or underscore, not digit
+        # Unlike regular identifiers, we don't need word boundary at start
+        # because ud-suffixes can follow digits (e.g., 123_udl)
+        pos = self.pos
+        if pos >= len(self.definition):
+            return None
+        first_char = self.definition[pos]
+        if first_char in '_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ':
+            # Start of ud-suffix, now match the rest
+            start = pos
+            pos += 1
+            while pos < len(self.definition) and self.definition[pos] in '_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789':
+                pos += 1
+            if pos > start:
+                self.pos = pos
+                return self.definition[start:pos]
+        return None
+
