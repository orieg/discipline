+class ASTUDLiteral(ASTLiteral):
+    def __init__(self, data: str, suffix: str) -> None:
+        self.data = data
+        self.suffix = suffix
+
+    def _stringify(self, transform: StringifyTransform) -> str:
+        return self.data + self.suffix
+
+    def get_id(self, version: int) -> str:
+        if version >= 4:
+            # Itanium C++ ABI mangling for user-defined literals
+            # Format: L_Zli<suffix_len><suffix>E<literal_mangled>E
+            literal_id = self._get_literal_id()
+            return "L_Zli%d%sl%sE" % (len(self.suffix), self.suffix, literal_id)
+        elif version == 3:
+            # Older format
+            return "L_Zli%d%sl%sl%sl%sl%sE" % (
+                len(self.suffix), self.suffix,
+                len(self.suffix), self.suffix,
+                len(self.suffix), self.suffix,
+                self._get_literal_id())
+        else:
+            # Fallback for older versions
+            return "L_Zli%d%sl%sl%sE" % (
+                len(self.suffix), self.suffix,
+                len(self.suffix), self.suffix,
+                self._get_literal_id())
+
+    def _get_literal_id(self) -> str:
+        """Get the mangled ID for the literal value."""
+        # Try to parse as a number literal
+        try:
+            # Check if it's a float
+            float(float(self.data))
+            return "L%slE" % self.data
+        except ValueError:
+            pass
+        # Otherwise, return as-is
+        return self.data
+
+    def describe_signature(self, signode: TextElement, mode: str,
+                           env: "BuildEnvironment", symbol: "Symbol") -> None:
+        txt = str(self)
+        signode.append(nodes.Text(txt, txt))
+
