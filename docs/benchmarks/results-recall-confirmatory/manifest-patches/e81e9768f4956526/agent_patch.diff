+                original = match.groupdict()
+                first_value = original.get(first_key)
+                if first_value and first_value.startswith('-'):
+                    # The duration is negative - flip all component signs
+                    # except the first one (which is already negative)
+                    first = True
+                    for key in kw:
+                        if first:
+                            first = False
+                        else:
+                            kw[key] = -kw[key]
