+class ASTUserDefinedLiteral(ASTExpression):
+    def __init__(self, value: ASTExpression, suffix: ASTIdentifier) -> None:
+        self.value = value
+        self.suffix = suffix
+
+    def _stringify(self, transform: StringifyTransform) -> str:
+        return transform(self.value) + transform(self.suffix)
+
+    def get_id(self, version: int) -> str:
+        # User-defined literal mangled name: clL_Zli<suffix_id>E<value_id>E
+        # where cl = call expression, Zli = literal operator local entity
+        res = ['cl', 'L_Zli']
+        res.append(self.suffix.get_id(version))
+        res.append('E')  # end of literal operator name
+        res.append(self.value.get_id(version))  # the value/argument
+        res.append('E')  # end of call expression
+        return ''.join(res)
+
+    def describe_signature(self, signode: TextElement, mode: str,
+                           env: "BuildEnvironment", symbol: "Symbol") -> None:
+        signode.append(nodes.Text(str(self)))
+
