+    def _post_save_validation(self):
+        """
+        After saving, if edit_only is True and there are extra forms with data,
+        add a non-form error to indicate that new object creation is not allowed.
+        """
+        if not self.is_bound:
+            return
+        for form in self.extra_forms:
+            if form.has_changed() and not (self.can_delete and self._should_delete_form(form)):
+                self._non_form_errors = self.error_class(
+                    [_('New object creation is not allowed in edit_only mode.')],
+                    renderer=self.renderer,
+                )
+                return
+
+    def save_new_objects(self, commit=True):
+        self.new_objects = []
+        # If edit_only is True, no new objects should be created.
+        if self.edit_only:
+            return self.new_objects
+        for form in self.extra_forms:
+            if not form.has_changed():
+                continue
+            # If someone has marked an add form for deletion, don't save the
+            # object.
+            if self.can_delete and self._should_delete_form(form):
+                continue
+            self.new_objects.append(self.save_new(form, commit=commit))
+            if not commit:
+                self.saved_forms.append(form)
+        return self.new_objects
 
