+def _is_mock_default(new, sentinels):
+    """Check if 'new' is a mock DEFAULT sentinel using identity comparison.
+
+    This avoids issues with objects that raise exceptions when compared for equality,
+    such as numpy arrays (#5606).
+    """
+    for sentinel in sentinels:
+        if new is sentinel:
+            return True
+    return False
