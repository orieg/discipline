     def set_source_expressions(self, exprs):
         self.lhs, self.rhs = exprs
 
+    def _resolve_output_field(self):
+        # Handle temporal subtraction: DateTimeField - DateTimeField -> DurationField
+        if self.connector == self.SUB:
+            try:
+                lhs_output_field = self.lhs.output_field
+            except FieldError:
+                lhs_output_field = None
+            try:
+                rhs_output_field = self.rhs.output_field
+            except FieldError:
+                rhs_output_field = None
+            if (
+                lhs_output_field is not None and
+                rhs_output_field is not None and
+                lhs_output_field.get_internal_type() in ('DateField', 'DateTimeField', 'TimeField') and
+                lhs_output_field.get_internal_type() == rhs_output_field.get_internal_type()
+            ):
+                return fields.DurationField()
+        return super()._resolve_output_field()
+
     def as_sql(self, compiler, connection):
         try:
             lhs_type = self.lhs.output_field.get_internal_type()
