+            # Since entities like &lt; and &amp; can change length when unescaped,
+            # and ; is both a punctuation char and part of entities, we need to
+            # iterate through the string from the end, keeping track of the
+            # mapping between original and unescaped characters.
+            new_trail = ''
+            i = len(middle)
+            while i > 0:
+                i -= 1
+                c = middle[i]
+                if c == '&':
+                    # Find the end of the entity (ends with ';' or non-entity char)
+                    j = i + 1
+                    while j < len(middle) and middle[j] not in ' ;\t\n\r':
+                        j += 1
+                    entity = middle[i:j + 1] if j < len(middle) and middle[j] == ';' else middle[i:j]
+                    entity_unescaped = html.unescape(entity)
+                    # Check if the unescaped entity is trailing punctuation
