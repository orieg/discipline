+                            i = entity_start - 1
+                        else:
+                            # Not a punctuation entity, just break
+                            break
+                    # If no & found, the ; is just punctuation (handled below)
+                    # Fall through to treat ; as punctuation
+                elif c in TRAILING_PUNCTUATION_CHARS:
+                    new_trail = c + new_trail
+                else:
