-        significand, exponent = value_str.split("E")
+
+    # Normalize exponent format: uppercase E, two-digit exponent
+    if "E" in value_str.upper():
+        # Handle both lowercase and uppercase e
+        if "e" in value_str:
+            significand, exponent = value_str.split("e")
+        else:
+            significand, exponent = value_str.split("E")
         if exponent[0] in ("+", "-"):
