+def _split_regex_csv(value: str) -> list[str]:
+    """Split a comma-separated string of regular expressions, respecting curly braces.
+
+    Commas inside curly braces (like quantifiers {1,3}) are not treated as separators.
+    """
+    patterns: list[str] = []
+    current: list[str] = []
+    brace_level = 0
+
+    for char in value:
+        if char == "{":
+            brace_level += 1
+            current.append(char)
+        elif char == "}":
+            brace_level -= 1
+            current.append(char)
+        elif char == "," and brace_level == 0:
+            # This is a separator at the top level
+            pattern = "".join(current).strip()
+            if pattern:
+                patterns.append(pattern)
+            current = []
+        else:
+            current.append(char)
+
+    # Don't forget the last pattern
+    pattern = "".join(current).strip()
+    if pattern:
+        patterns.append(pattern)
+
+    return patterns
+
+
 def _regexp_csv_transfomer(value: str) -> Sequence[Pattern[str]]:
