+    @staticmethod
+    def reduce_options(options, operation):
+        """
+        Reduce AlterModelOptions and AlterTogetherOptionOperation operations
+        into CreateModel's options.
+        """
+        if isinstance(operation, AlterModelOptions):
+            # Merge operation.options into options, then remove any keys
+            # in ALTER_OPTION_KEYS that are not in operation.options
+            # This mimics the logic in AlterModelOptions.state_forwards()
+            result = {**options, **operation.options}
+            for key in AlterModelOptions.ALTER_OPTION_KEYS:
+                if key not in operation.options:
+                    result.pop(key, None)
+            return result
+        elif isinstance(operation, AlterTogetherOptionOperation):
+            # For AlterUniqueTogether and AlterIndexTogether, just set the
+            # specific option (no removal logic needed as these always set
+            # a specific value for their option_name)
+            return {**options, **{operation.option_name: operation.option_value}}
+        elif isinstance(operation, AlterOrderWithRespectTo):
+            # For AlterOrderWithRespectTo, set the order_with_respect_to option
+            return {**options, 'order_with_respect_to': operation.order_with_respect_to}
+        return options
+
