+def _split_param_type(fieldarg: str) -> Tuple[str, str]:
+    """Split the fieldarg into type and name, respecting brackets.
+    
+    This handles cases like "Dict[str, str] params" correctly,
+    splitting into ("Dict[str, str]", "params") instead of
+    ("Dict[str,", "str] params").
+    """
+    depth = 0
+    for i, c in enumerate(fieldarg):
+        if c in '([{':
+            depth += 1
+        elif c in ')]}':
+            depth -= 1
+        elif c == ' ' and depth == 0:
+            # Found the split point
+            argtype = fieldarg[:i].strip()
+            argname = fieldarg[i + 1:].strip()
+            return argtype, argname
+    # No whitespace found outside brackets
+    return fieldarg, ''
+
