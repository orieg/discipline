diff --git a/django/core/mail/utils.py b/django/core/mail/utils.py
--- a/django/core/mail/utils.py
+++ b/django/core/mail/utils.py
@@ -13,7 +13,15 @@
 
     def get_fqdn(self):
         if not hasattr(self, '_fqdn'):
-            self._fqdn = socket.getfqdn()
+            fqdn = socket.getfqdn()
+            # Convert non-ASCII FQDNs to ASCII using IDNA encoding.
+            try:
+                fqdn.encode('ascii')
+            except UnicodeEncodeError:
+                fqdn = '.'.join(
+                    part.encode('idna').decode('ascii') for part in fqdn.split('.')
+                )
+            self._fqdn = fqdn
         return self._fqdn
 
 
