                 expressions.extend(expr.get_group_by_cols())
+        # Meta.ordering fields must not affect GROUP BY clause.
+        if self._meta_ordering:
+            # If ordering comes from Meta.ordering, remove added columns from
+            # GROUP BY since Meta.ordering shouldn't affect aggregation.
+            expressions = [
+                expr for expr in expressions
+                if expr not in (
