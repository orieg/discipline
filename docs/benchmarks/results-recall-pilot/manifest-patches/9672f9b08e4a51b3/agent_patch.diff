+def _is_bool_array(z):
+    """Check if z is a boolean array (numpy or Python list-like)."""
+    if hasattr(z, 'dtype'):
+        return z.dtype == bool
+    elif isinstance(z, (list, tuple)):
+        for item in z:
+            if isinstance(item, (list, tuple)):
+                if _is_bool_array(item):
+                    return True
+            else:
+                if isinstance(item, bool):
+                    return True
+    return False
