diff --git a/tests/user_commands/management/commands/mutually_exclusive_required.py b/tests/user_commands/management/commands/mutually_exclusive_required.py
new file mode 100644
--- /dev/null
+++ b/tests/user_commands/management/commands/mutually_exclusive_required.py
@@ -0,0 +1,16 @@
+from django.core.management.base import BaseCommand
+
+
+class Command(BaseCommand):
+    def add_arguments(self, parser):
+        shop = parser.add_mutually_exclusive_group(required=True)
+        shop.add_argument('--foo-id', dest='foo_id', type=int, default=None)
+        shop.add_argument('--foo-name', dest='foo_name', type=str, default=None)
+
+    def handle(self, *args, **options):
+        foo_id = options.get('foo_id')
+        foo_name = options.get('foo_name')
+        if foo_id is not None:
+            self.stdout.write('foo_id')
+        if foo_name is not None:
+            self.stdout.write('foo_name')
