+def get_unpacked_marks(
+    obj: object, consider_mro: bool = True
+) -> Iterable[Mark]:
+    """Obtain the unpacked marks that are stored on an object.
+
+    :param obj:
+        The object to get marks from.
+    :param consider_mro:
+        If True, marks from base classes in the MRO are also collected.
+        This is useful for class markers which are inherited through MRO.
+    """
     mark_list = getattr(obj, "pytestmark", [])
     if not isinstance(mark_list, list):
         mark_list = [mark_list]
+
+    if consider_mro:
+        # Collect marks from the MRO, starting from the most derived class.
+        # This ensures that marks from subclasses take precedence over base classes.
+        # We access __dict__ directly to avoid MRO-based attribute lookup which
+        # would only return the first matching class's pytestmark.
+        result: List[Mark] = []
+        for cls in getattr(obj, "__mro__", []):
+            for mark in normalize_mark_list(cls.__dict__.get("pytestmark", [])):
+                result.append(mark)
+        return result
+
     return normalize_mark_list(mark_list)
 
 
