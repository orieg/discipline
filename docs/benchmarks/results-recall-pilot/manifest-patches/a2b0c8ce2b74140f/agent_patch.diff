diff --git a/pylint/checkers/variables.py b/pylint/checkers/variables.py
--- a/pylint/checkers/variables.py
+++ b/pylint/checkers/variables.py
@@ -1826,6 +1826,17 @@
             self._type_annotation_names.append(type_annotation.name)
             return
 
+        if isinstance(type_annotation, astroid.Attribute):
+            # Handle attribute access like `module.Class` by extracting the module name
+            # from the expression (e.g., `abc` from `abc.ABC`)
+            # For nested attributes like `a.b.c`, find the base module name
+            base = type_annotation
+            while isinstance(base, astroid.Attribute):
+                base = base.expr
+            if isinstance(base, astroid.Name):
+                self._type_annotation_names.append(base.name)
+            return
+
         if not isinstance(type_annotation, astroid.Subscript):
             return
 
