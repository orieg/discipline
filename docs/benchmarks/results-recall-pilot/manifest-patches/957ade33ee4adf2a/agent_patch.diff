+def _is_mutually_exclusive_group_required(action, parser):
+    """
+    Check if an action is part of a required mutually exclusive group.
+    Handles subparsers by recursively checking all subparsers.
+    """
+
+    def check_group(action, parser):
+        for group in parser._mutually_exclusive_groups:
+            if group.required and action in group._group_actions:
+                return True
+        return False
+
+    if check_group(action, parser):
+        return True
+
+    # Recursively check subparsers
+    def check_subparsers(parser):
+        for opt in parser._actions:
+            if isinstance(opt, _SubParsersAction):
+                for sub_opt in opt.choices.values():
+                    if check_group(action, sub_opt):
+                        return True
+                    if check_subparsers(sub_opt):
+                        return True
+        return False
+
+    return check_subparsers(parser)
+
