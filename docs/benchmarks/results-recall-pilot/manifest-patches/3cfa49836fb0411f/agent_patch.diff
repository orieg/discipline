+def compile_json_key_path(key_transforms):
+    """
+    Compile key transforms to a JSON path for object key lookups.
+
+    Unlike compile_json_path(), this always uses string key syntax
+    (e.g., $."key" or $.key) instead of array index syntax (e.g., $[0]).
+    This is appropriate for has_key/has_keys/has_any_keys lookups where
+    we're always looking for object keys, not array indices.
+
+    The path does NOT include the root '$' - it should be appended to an
+    existing path.
+    """
+    path = []
+    for key_transform in key_transforms:
+        # Always use string key syntax for object keys
+        path.append(".")
+        path.append(json.dumps(key_transform))
+    return "".join(path)
+
