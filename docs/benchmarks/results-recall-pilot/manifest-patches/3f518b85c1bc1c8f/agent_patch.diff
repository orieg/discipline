+        for base in obj.__mro__:
+            if base is obj:
+                continue  # already processed
+            base_marks = base.__dict__.get("pytestmark", [])
+            if not isinstance(base_marks, list):
+                base_marks = [base_marks]
+            result.extend(normalize_mark_list(base_marks))
