+    def is_required_option(opt):
+        """Return True if an option is required."""
+        if opt.required:
+            return True
+        # Check if option is part of a required mutually exclusive group.
+        for group in parser._mutually_exclusive_groups:
+            if group.required and opt in group._group_actions:
+                return True
+        return False
