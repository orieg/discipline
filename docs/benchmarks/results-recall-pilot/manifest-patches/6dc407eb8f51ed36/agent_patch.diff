+# Add tests to path
+import sys
+sys.path.insert(0, 'tests')
+
+# Setup Django
+import os
+os.environ['DJANGO_SETTINGS_MODULE'] = 'test_sqlite'
+
+import django
+django.setup()
+
+from django.db import connection
+from queries.models import ReservedName
+
+# Create tables using Django's migration framework
+from django.core.management import call_command
+from django.db import connection
+
+# Create the tables
+from django.db.migrations.executor import MigrationExecutor
+from django.db.migrations.loader import MigrationLoader
+
+# Use a simpler approach - create the tables directly
+with connection.schema_editor() as schema_editor:
+    schema_editor.create_model(ReservedName)
+
+# Create test data
+ReservedName.objects.all().delete()
+ReservedName.objects.bulk_create([
+    ReservedName(name='rn1', order=7),
+    ReservedName(name='rn2', order=5),
+    ReservedName(name='rn0', order=6),
+    ReservedName(name='rn9', order=-1),
+])
+
+# Test case
+qs1 = ReservedName.objects.filter(order__gte=6)
+qs2 = ReservedName.objects.filter(order__lte=5)
+union_qs = qs1.union(qs2)
+
+print(f"Union order_by: {union_qs.query.order_by}")
+
+ordered_qs = union_qs.order_by('-pk')
+print(f"Ordered order_by: {ordered_qs.query.order_by}")
+print(f"Ordered values_select: {ordered_qs.query.values_select}")
+
+values_qs = ordered_qs.values_list('order', flat=True)
+print(f"Values order_by: {values_qs.query.order_by}")
+print(f"Values values_select: {values_qs.query.values_select}")
+
+# Print the SQL
+try:
+    from django.db import connection
+    compiler = values_qs.query.get_compiler(using=connection.alias)
+    sql, params = compiler.as_sql()
+    print(f"\nSQL: {sql}")
+    print(f"Params: {params}")
+except Exception as e:
+    import traceback
+    traceback.print_exc()
