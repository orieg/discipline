+import sys
+sys.path.insert(0, 'tests')
+
+import os
+os.environ['DJANGO_SETTINGS_MODULE'] = 'test_sqlite'
+
+import django
+from django.conf import settings
+
+# Setup Django
+django.setup()
+
+# Run migrations
+from django.core.management import call_command
+call_command('migrate', '--run-syncdb', verbosity=0)
+
+# Now test the issue
+from queries.models import ReservedName
+
+# Clean up
+ReservedName.objects.all().delete()
+
+# Create test data
+ReservedName.objects.bulk_create([
+    ReservedName(name='rn1', order=7),
+    ReservedName(name='rn2', order=5),
+    ReservedName(name='rn0', order=6),
+    ReservedName(name='rn9', order=-1),
+])
+
+# Test case 1: order_by then values_list
+print("Test 1: union.order_by('pk').values_list('order', flat=True)")
+qs1 = ReservedName.objects.filter(order__gte=6)
+qs2 = ReservedName.objects.filter(order__lte=5)
+union_qs = qs1.union(qs2)
+try:
+    result = list(union_qs.order_by('pk').values_list('order', flat=True))
+    print(f"Result: {result}")
+except Exception as e:
+    import traceback
+    traceback.print_exc()
+
+print("\nTest 2: union.values_list('order', flat=True).order_by('pk')")
+qs1 = ReservedName.objects.filter(order__gte=6)
+qs2 = ReservedName.objects.filter(order__lte=5)
+union_qs = qs1.union(qs2)
+try:
+    result = list(union_qs.values_list('order', flat=True).order_by('pk'))
+    print(f"Result: {result}")
+except Exception as e:
+    import traceback
+    traceback.print_exc()
