+class SubParsersAction(argparse._SubParsersAction):
+    """
+    Custom _SubParsersAction that copies CommandParser-specific attributes
+    when creating subparsers.
+    """
+
+    def add_parser(self, name, **kwargs):
+        # Copy CommandParser-specific attributes from the parent parser.
+        if hasattr(self, "_parent_parser"):
+            parent = self._parent_parser
+            if parent.called_from_command_line is not None:
+                kwargs.setdefault(
+                    "called_from_command_line", parent.called_from_command_line
+                )
+            if parent.missing_args_message is not None:
+                kwargs.setdefault(
+                    "missing_args_message", parent.missing_args_message
+                )
+        return super().add_parser(name, **kwargs)
+
