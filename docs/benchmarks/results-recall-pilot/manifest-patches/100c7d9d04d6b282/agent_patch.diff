diff --git a/django/utils/autoreload.py b/django/utils/autoreload.py
--- a/django/utils/autoreload.py
+++ b/django/utils/autoreload.py
@@ -221,7 +221,16 @@
     py_script = Path(sys.argv[0])
 
     args = [sys.executable] + ['-W%s' % o for o in sys.warnoptions]
-    if py_script == django_main_path:
+    # __main__.__spec__ is not None if and only if Python was launched with -m.
+    # __main__.__spec__.parent is the package name (e.g., 'django' or
+    # 'utils_tests.test_module').
+    main_module = sys.modules.get('__main__')
+    main_spec = getattr(main_module, '__spec__', None)
+    if main_spec is not None and main_spec.parent:
+        # Python was started with `python -m <parent> ...`.
+        args += ['-m', main_spec.parent]
+        args += sys.argv[1:]
+    elif py_script == django_main_path:
         # The server was started with `python -m django runserver`.
         args += ['-m', 'django']
         args += sys.argv[1:]
