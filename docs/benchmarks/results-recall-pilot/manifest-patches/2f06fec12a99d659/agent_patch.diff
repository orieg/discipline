+class _SubParsersAction(argparse._SubParsersAction):
+    """
+    Customized _SubParsersAction to copy CommandParser-specific attributes
+    to subparsers.
+    """
+
+    def __init__(
+        self,
+        option_strings,
+        prog,
+        parser_class,
+        dest=argparse.SUPPRESS,
+        required=False,
+        help=None,
+        metavar=None,
+        **kwargs,
+    ):
+        self._called_from_command_line = kwargs.pop(
+            "_called_from_command_line", None
+        )
+        self._missing_args_message = kwargs.pop("_missing_args_message", None)
+        super().__init__(
+            option_strings,
+            prog,
+            parser_class,
+            dest=dest,
+            required=required,
+            help=help,
+            metavar=metavar,
+        )
+
+    def add_parser(self, name, **kwargs):
+        # Copy CommandParser-specific attributes from the parent parser.
+        # This ensures subparsers inherit error handling behavior.
+        if self._called_from_command_line is not None:
+            kwargs.setdefault(
+                "called_from_command_line", self._called_from_command_line
+            )
+        if self._missing_args_message is not None:
+            kwargs.setdefault(
+                "missing_args_message", self._missing_args_message
+            )
+        return super().add_parser(name, **kwargs)
+
