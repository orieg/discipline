diff --git a/django/utils/numberformat.py b/django/utils/numberformat.py
--- a/django/utils/numberformat.py
+++ b/django/utils/numberformat.py
@@ -27,6 +27,19 @@
     # sign
     sign = ''
     if isinstance(number, Decimal):
+        # Handle very small numbers that would be all zeros with decimal_pos.
+        # This prevents exponential notation for numbers like 1e-200 with
+        # decimal_pos=2 which should return '0.00'.
+        if decimal_pos is not None:
+            _, digits, exponent = number.as_tuple()
+            # The number's absolute value is less than 10^(-decimal_pos) when
+            # the position of the first significant digit is after decimal_pos.
+            # For a Decimal with exponent `exp` and `len(digits)` digits,
+            # the number is digits * 10^exp. If len(digits) + exp <= -decimal_pos,
+            # all digits are in positions beyond decimal_pos.
+            if len(digits) + exponent <= -decimal_pos:
+                sign = '-' if number < 0 else ''
+                return sign + '0' + decimal_sep + '0' * decimal_pos
         # Format values with more than 200 digits (an arbitrary cutoff) using
         # scientific notation to avoid high memory usage in {:f}'.format().
         _, digits, exponent = number.as_tuple()
