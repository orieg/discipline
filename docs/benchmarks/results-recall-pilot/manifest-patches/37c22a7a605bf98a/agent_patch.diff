+def _deserialize_entry(entry_data):
+    """Deserialize a single ReprEntry or ReprEntryNative."""
+    data = entry_data["data"]
+    entry_type = entry_data["type"]
+    if entry_type == "ReprEntry":
+        reprfuncargs = None
+        reprfileloc = None
+        reprlocals = None
+        if data["reprfuncargs"]:
+            reprfuncargs = ReprFuncArgs(**data["reprfuncargs"])
+        if data["reprfileloc"]:
+            reprfileloc = ReprFileLocation(**data["reprfileloc"])
+        if data["reprlocals"]:
+            reprlocals = ReprLocals(data["reprlocals"]["lines"])
+
+        reprentry = ReprEntry(
+            lines=data["lines"],
+            reprfuncargs=reprfuncargs,
+            reprlocals=reprlocals,
+            filelocrepr=reprfileloc,
+            style=data["style"],
+        )
+    elif entry_type == "ReprEntryNative":
+        reprentry = ReprEntryNative(data["lines"])
+    else:
+        raise RuntimeError(f"Unknown entry type: {entry_type}")
+    return reprentry
+
+
+def _deserialize_reprtraceback(reprtraceback_data):
+    """Deserialize a ReprTraceback object."""
+    reprentries = []
+    for entry_data in reprtraceback_data["reprentries"]:
+        reprentries.append(_deserialize_entry(entry_data))
+    reprtraceback_data["reprentries"] = reprentries
+    return ReprTraceback(**reprtraceback_data)
+
+
+def _deserialize_reprcrash(reprcrash_data):
+    """Deserialize a ReprFileLocation object, or return None."""
+    if reprcrash_data is None:
+        return None
+    return ReprFileLocation(**reprcrash_data)
+
+
+def _deserialize_exception_chain(longrepr_data):
+    """Deserialize an ExceptionChainRepr from serialized data."""
+    chain = []
+    for entry_data in longrepr_data["chain"]:
+        reprtraceback = _deserialize_reprtraceback(entry_data["reprtraceback"])
+        reprcrash = _deserialize_reprcrash(entry_data["reprcrash"])
+        description = entry_data["description"]
+        chain.append((reprtraceback, reprcrash, description))
+    
+    longrepr = ExceptionChainRepr(chain)
+    for section in longrepr_data["sections"]:
+        longrepr.addsection(*section)
+    return longrepr
+
+
+def _deserialize_single_exception(longrepr_data):
+    """Deserialize a single ReprExceptionInfo from serialized data."""
+    reprtraceback = longrepr_data["reprtraceback"]
+    reprcrash = longrepr_data["reprcrash"]
+
+    reprentries = []
+    for entry_data in reprtraceback["reprentries"]:
+        reprentries.append(_deserialize_entry(entry_data))
+    reprtraceback["reprentries"] = reprentries
+
+    exception_info = ReprExceptionInfo(
+        reprtraceback=ReprTraceback(**reprtraceback),
+        reprcrash=ReprFileLocation(**reprcrash) if reprcrash else None,
+    )
+
+    for section in longrepr_data["sections"]:
+        exception_info.addsection(*section)
+    return exception_info
 
 
