+class CommandParserSubParsersAction(argparse._SubParsersAction):
+    """
+    Subclass of argparse._SubParsersAction that passes through the
+    CommandParser-specific arguments (called_from_command_line,
+    missing_args_message) to subparsers so they use the same error handling.
+    """
+
+    def __init__(self, *args, called_from_command_line=None, **kwargs):
+        self._called_from_command_line = called_from_command_line
+        # Pop missing_args_message if present (for backward compatibility).
+        self._missing_args_message = kwargs.pop("missing_args_message", None)
+        super().__init__(*args, **kwargs)
+
+    def add_parser(self, name, **kwargs):
+        # Pass through the CommandParser-specific arguments only if the
+        # parser_class is CommandParser. This ensures that if someone uses
+        # a different parser_class (e.g., argparse.ArgumentParser), we don't
+        # interfere with their error handling.
+        if kwargs.get("parser_class") is CommandParser or (
+            kwargs.get("parser_class") is None and self._parser_class is CommandParser
+        ):
+            kwargs.setdefault(
+                "called_from_command_line", self._called_from_command_line
+            )
+            kwargs.setdefault("missing_args_message", self._missing_args_message)
+        return super().add_parser(name, **kwargs)
+
