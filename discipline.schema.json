{
  "$defs": {
    "ArchiveContentsGate": {
      "additionalProperties": false,
      "properties": {
        "archive_path": {
          "description": "Glob pattern matching the built archive file",
          "type": "string"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "forbidden_patterns": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Regex patterns forbidden inside the archive"
        },
        "required_paths": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Files required to exist inside the archive"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "strip_components": {
          "description": "Leading directory components to strip from archive paths",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "AssertionGate": {
      "additionalProperties": false,
      "properties": {
        "assert_helper_fns": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "extra_assert_macros": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "min_assertions_per_test": {
          "description": "Minimum assertions required per test method",
          "type": "integer"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "BasicGate": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "BenchRegressionGate": {
      "additionalProperties": false,
      "properties": {
        "advisory_pct": {
          "description": "Advisory review percentage (default: 0.1%)",
          "type": "number"
        },
        "allow_cross_host": {
          "description": "Allow benchmark comparison across mismatched host/runner provenance",
          "type": "boolean"
        },
        "base_file": {
          "description": "In-job base benchmark result file path for dual-file regression checks",
          "type": "string"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_arms": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Declared exempt benchmark arms"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "head_file": {
          "description": "In-job head benchmark result file path for dual-file regression checks",
          "type": "string"
        },
        "max_noise_cv": {
          "description": "Maximum acceptable coefficient of variation (std_dev / mean)",
          "type": "number"
        },
        "noise_floor_pct": {
          "description": "Noise floor percentage (default: 0.5%)",
          "type": "number"
        },
        "noise_margin_pct": {
          "description": "Configurable noise margin added to tolerance_pct",
          "type": "number"
        },
        "paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "provenance": {
          "description": "Expected host/runner provenance tag for benchmark artifacts",
          "type": "string"
        },
        "require_sourced_override": {
          "description": "Require allow-regression reasons to cite a CI run URL or artifact path and name the arms",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "tolerance_pct": {
          "description": "Maximum allowed regression percentage",
          "type": "number"
        }
      },
      "type": "object"
    },
    "CiIntegrityGate": {
      "additionalProperties": false,
      "properties": {
        "diff_only": {
          "description": "When true, scans only modified workflow files rather than all workflows",
          "type": "boolean"
        },
        "documented_job_count_path": {
          "description": "Path to catalog documentation stating job count",
          "type": "string"
        },
        "documented_job_count_pattern": {
          "description": "Regex pattern to extract job count from documentation",
          "type": "string"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "excluded_jobs": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Job names excluded from rollup dependency requirements"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "first_party_action_prefixes": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Action prefixes considered first-party and excused from commit SHA pinning"
        },
        "forbid_continue_on_error": {
          "description": "Forbid continue-on-error: true in workflow jobs or steps",
          "type": "boolean"
        },
        "forbid_or_true": {
          "description": "Forbid || true and set +e error masking in run commands",
          "type": "boolean"
        },
        "pin_actions": {
          "description": "Ensure third-party GitHub actions are pinned by 40-character commit SHA",
          "type": "boolean"
        },
        "rollup_job": {
          "description": "Name of the rollup job that must depend on all jobs",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "workflows": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Workflow file patterns to inspect"
        }
      },
      "type": "object"
    },
    "CommandEntry": {
      "additionalProperties": false,
      "properties": {
        "allow_zero": {
          "description": "Whether zero items selected is allowed",
          "type": "boolean"
        },
        "canary_command": {
          "description": "Optional negative-control canary command",
          "type": "string"
        },
        "canary_expected_diagnostic": {
          "description": "Expected diagnostic string that canary must produce",
          "type": "string"
        },
        "command": {
          "description": "Command string to execute",
          "type": "string"
        },
        "count_pattern": {
          "description": "Regex pattern to extract an integer count",
          "type": "string"
        },
        "forbid_output": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Output patterns that must not appear in stdout or stderr"
        },
        "min_count": {
          "description": "Minimum count required",
          "type": "integer"
        },
        "name": {
          "description": "Name or identifier of the command",
          "type": "string"
        },
        "preset": {
          "description": "Predefined turnkey preset name (e.g. cargo-mutants, cargo-deny, loom)",
          "type": "string"
        },
        "timeout_seconds": {
          "description": "Execution timeout in seconds",
          "type": "integer"
        },
        "zero_items_pattern": {
          "description": "Pattern that indicates zero items were executed",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "CommandGate": {
      "additionalProperties": false,
      "properties": {
        "allow_zero": {
          "description": "Whether zero items selected is allowed",
          "type": "boolean"
        },
        "canary_command": {
          "description": "Optional negative-control canary command",
          "type": "string"
        },
        "canary_expected_diagnostic": {
          "description": "Expected diagnostic string that canary must produce",
          "type": "string"
        },
        "command": {
          "description": "Primary command to execute",
          "type": "string"
        },
        "commands": {
          "description": "Multi-command suite entries",
          "items": {
            "$ref": "#/$defs/CommandEntry"
          },
          "type": "array"
        },
        "count_pattern": {
          "description": "Regex pattern to extract an integer count",
          "type": "string"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "forbid_output": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Output patterns that must not appear in stdout or stderr"
        },
        "min_count": {
          "description": "Minimum count required",
          "type": "integer"
        },
        "preset": {
          "description": "Predefined turnkey preset name (e.g. cargo-mutants, cargo-deny, loom)",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "timeout_seconds": {
          "description": "Execution timeout in seconds (default: 60s)",
          "type": "integer"
        },
        "zero_items_pattern": {
          "description": "Pattern that indicates zero items were executed",
          "type": "string"
        }
      },
      "type": "object"
    },
    "DeletionGate": {
      "additionalProperties": false,
      "properties": {
        "allow_hidden": {
          "description": "When true, HTML-comment-wrapped directives are accepted for deletions",
          "type": [
            "boolean",
            "null"
          ]
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "require_scope": {
          "description": "When true, directive must name the deleted file or test",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "DependencyDeltaGate": {
      "additionalProperties": false,
      "properties": {
        "allow_dependencies": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Explicit list of allowed dependency package names"
        },
        "allow_wildcards": {
          "description": "Whether wildcard versions are permitted (default: false)",
          "type": "boolean"
        },
        "deny_dependencies": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Explicit list of forbidden dependency package names"
        },
        "deny_file": {
          "description": "Path to deny.toml policy file",
          "type": "string"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "manifests": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Manifest file globs to inspect"
        },
        "require_git_pins": {
          "description": "Whether git dependencies must specify an immutable commit or tag pin (default: true)",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "GoldenGate": {
      "additionalProperties": false,
      "properties": {
        "allow_updates": {
          "description": "Permit snapshot updates without error",
          "type": "boolean"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "IgnoredTestsGate": {
      "additionalProperties": false,
      "properties": {
        "approved_predicates": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Conditional ignore predicates (e.g. miri) approved by policy"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "IssueLinkGate": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "pattern": {
          "description": "Custom regex pattern required in PR title or body",
          "type": "string"
        },
        "require_in_commit_if_no_pr": {
          "description": "Require issue link in commit messages when no PR metadata is supplied",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "ManifestSyncGate": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "rules": {
          "description": "Rules reconciling packaging manifests against git-tracked files",
          "items": {
            "additionalProperties": false,
            "properties": {
              "exclude_paths": {
                "$ref": "#/$defs/StringListOrReset",
                "description": "Globs excluded from manifest registration requirement"
              },
              "extract_regex": {
                "description": "Regex to extract relative file paths from manifest",
                "type": "string"
              },
              "manifest": {
                "description": "Path to packaging manifest (e.g. package.xml)",
                "type": "string"
              },
              "watched_paths": {
                "$ref": "#/$defs/StringListOrReset",
                "description": "Git file globs that must be registered in the manifest"
              }
            },
            "required": [
              "manifest",
              "extract_regex",
              "watched_paths"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "MiriGate": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Additional CLI arguments passed to cargo miri test"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "timeout_seconds": {
          "description": "Maximum execution time in seconds before failing closed (default: 600)",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "MsrvGate": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "Command to run to verify MSRV compatibility",
          "type": [
            "string",
            "null"
          ]
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "pinned_version": {
          "description": "Explicit MSRV version string (e.g. \"1.90.0\")",
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "PiiGate": {
      "additionalProperties": false,
      "properties": {
        "agent_config_refs": {
          "description": "When true, flags references to personal agent configuration directories and playbook docs",
          "type": "boolean"
        },
        "allow_patterns": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "allowed_users": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "diff_only": {
          "description": "When true, scans only modified lines in the git diff rather than all tracked files",
          "type": "boolean"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "extra_patterns": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "home_paths": {
          "description": "Check for leaked home directory paths",
          "type": "boolean"
        },
        "hostname_denylist": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "lan_ips": {
          "description": "Check for leaked private LAN IPs",
          "type": "boolean"
        },
        "scan_pr_body": {
          "description": "Whether to scan PR description text",
          "type": "boolean"
        },
        "secrets": {
          "description": "Check for leaked private keys and high-entropy API tokens",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "PrChecklistGate": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "ProvenanceTagsGate": {
      "additionalProperties": false,
      "properties": {
        "check_intervals": {
          "description": "Check published wall-clock ratios for confidence intervals or explicit qualifiers",
          "type": "boolean"
        },
        "check_mechanisms": {
          "description": "Check for mechanism claims without hardware counter evidence or explicit hypothesis qualifiers",
          "type": "boolean"
        },
        "check_paired_figures": {
          "description": "Check paired figures for shared workload IDs or differentiation tags",
          "type": "boolean"
        },
        "check_tables": {
          "description": "Check markdown tables for unit-bearing numbers without table or caption provenance tags",
          "type": "boolean"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "SanitizersGate": {
      "additionalProperties": false,
      "properties": {
        "canary": {
          "description": "Whether to verify a negative-control race canary before main tests",
          "type": "boolean"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "sanitizer": {
          "description": "Sanitizer name to activate (e.g. \"address\", \"thread\")",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "timeout_seconds": {
          "description": "Maximum execution time in seconds (default: 300)",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ScopeConfinementGate": {
      "additionalProperties": false,
      "properties": {
        "allowed_paths": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Glob patterns of paths agents are authorized to modify"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "forbidden_paths": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Glob patterns of paths agents are strictly forbidden to touch"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "ScratchGate": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "Severity": {
      "description": "Violation severity: error (blocking, exit 1), warning (non-blocking), or info.",
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "type": "string"
    },
    "ShellSecretsGate": {
      "additionalProperties": false,
      "properties": {
        "allow_patterns": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Custom regex patterns exempted from violation"
        },
        "diff_only": {
          "description": "When true, scans only modified lines in the git diff rather than all tracked files",
          "type": "boolean"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "extra_secret_patterns": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Additional custom regex patterns for sensitive secret variable names"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "StringListOrReset": {
      "description": "A list of strings, or a table with reset = true to clear lower precedence layers.",
      "oneOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "additionalProperties": false,
          "properties": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "reset": {
              "type": "boolean"
            }
          },
          "required": [
            "reset"
          ],
          "type": "object"
        }
      ]
    },
    "SuppressionDeltaGate": {
      "additionalProperties": false,
      "properties": {
        "allowed_suppressions": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Specific suppression patterns explicitly permitted by policy"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "max_increase": {
          "description": "Maximum net increase in suppression annotations permitted (default: 0)",
          "type": "integer"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "TestBudgetGate": {
      "additionalProperties": false,
      "properties": {
        "corpus_dirs": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Corpus directory patterns to monitor for seed file shrink"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "fuzz_targets": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Fuzz manifest and harness globs"
        },
        "scan_scripts": {
          "description": "Whether to scan shell scripts",
          "type": "boolean"
        },
        "scan_workflows": {
          "description": "Whether to scan workflow files",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "TestFloorGate": {
      "additionalProperties": false,
      "properties": {
        "constant_file": {
          "description": "File containing a floor constant",
          "type": "string"
        },
        "constant_name": {
          "description": "Name of the floor constant in constant_file",
          "type": "string"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "min_tests": {
          "description": "Minimum required workspace test count",
          "type": "integer"
        },
        "required_suites": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Required test suite files that must exist"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "test_command": {
          "description": "Custom command to list or count tests",
          "type": "string"
        },
        "tolerance": {
          "description": "Allowed test count decrease below floor or base before violation (default: 0)",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "TimeEstimateGate": {
      "additionalProperties": false,
      "properties": {
        "allow_patterns": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "diff_only": {
          "description": "When true, scans only modified lines in the git diff rather than all tracked files",
          "type": "boolean"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "extra_patterns": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "include": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "scan_pr_body": {
          "description": "Whether to scan PR description text",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "UnsafeBudgetGate": {
      "additionalProperties": false,
      "properties": {
        "allow_increase": {
          "description": "Whether total unsafe count may increase over base ref without override",
          "type": "boolean"
        },
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "max_unsafe": {
          "description": "Maximum total number of unsafe sites allowed in head ref",
          "type": [
            "integer",
            "null"
          ]
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "UnsafeSafetyCommentGate": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "placeholders": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Additional placeholder words or phrases to reject in SAFETY comments"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    },
    "VersionLockstepGate": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "description": "Whether this gate is active",
          "type": "boolean"
        },
        "exempt_paths": {
          "$ref": "#/$defs/StringListOrReset"
        },
        "groups": {
          "description": "Groups of sources that must declare identical version strings",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "Name of the version lockstep group",
                "type": "string"
              },
              "sources": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "description": "Source file path",
                      "type": "string"
                    },
                    "regex": {
                      "description": "Regex pattern capturing the version string in group 1",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "regex"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "name",
              "sources"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Configuration schema for Discipline CI/CD gatekeeper and agent diff sentinel (discipline.toml)",
  "properties": {
    "directives": {
      "additionalProperties": false,
      "description": "Policy controls for override directives (sources and visibility)",
      "properties": {
        "allow_hidden": {
          "description": "Allow directives hidden inside HTML comments <!-- --> (default: false)",
          "type": "boolean"
        },
        "allowed_override_actors": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Actors authorized to apply overrides even when fail_on_overrides is true (default: [])"
        },
        "fail_on_overrides": {
          "description": "Treat applied overrides as failures requiring human sign-off (default: false)",
          "type": "boolean"
        },
        "sources": {
          "$ref": "#/$defs/StringListOrReset",
          "description": "Allowed directive sources: pr-body, commits (default: [\"pr-body\", \"commits\"])"
        }
      },
      "type": "object"
    },
    "gates": {
      "additionalProperties": false,
      "description": "Per-gate settings. By default, every available gate is enabled at severity \"error\".",
      "properties": {
        "agent-scratch": {
          "allOf": [
            {
              "$ref": "#/$defs/ScratchGate"
            }
          ],
          "description": "agent scratch state is never tracked"
        },
        "agents-md": {
          "allOf": [
            {
              "$ref": "#/$defs/BasicGate"
            }
          ],
          "description": "AGENTS.md exists; CLAUDE.md / GEMINI.md do not fork it"
        },
        "archive-contents": {
          "allOf": [
            {
              "$ref": "#/$defs/ArchiveContentsGate"
            }
          ],
          "description": "distribution archive must contain required paths and zero forbidden developer artifacts"
        },
        "assertion-reduction": {
          "allOf": [
            {
              "$ref": "#/$defs/AssertionGate"
            }
          ],
          "description": "assertion count / strength must not drop in an existing test"
        },
        "bench-regression": {
          "allOf": [
            {
              "$ref": "#/$defs/BenchRegressionGate"
            }
          ],
          "description": "benchmark drift via harness adapters (deterministic counts or BCa intervals)"
        },
        "ci-integrity": {
          "allOf": [
            {
              "$ref": "#/$defs/CiIntegrityGate"
            }
          ],
          "description": "workflow weakening: continue-on-error, || true, unpinned actions"
        },
        "command": {
          "allOf": [
            {
              "$ref": "#/$defs/CommandGate"
            }
          ],
          "description": "fail-closed wrapper for any tool: zero-tests guard, canary, count ratchet"
        },
        "config-integrity": {
          "allOf": [
            {
              "$ref": "#/$defs/BasicGate"
            }
          ],
          "description": "a change cannot weaken its own discipline.toml without a token"
        },
        "deletion-rationale": {
          "allOf": [
            {
              "$ref": "#/$defs/DeletionGate"
            }
          ],
          "description": "deleted files and removed tests need a scoped removes: rationale"
        },
        "dependency-delta": {
          "allOf": [
            {
              "$ref": "#/$defs/DependencyDeltaGate"
            }
          ],
          "description": "manifest diff inspection: zero wildcards, source/license allowlists, and deny.toml verification"
        },
        "golden-output": {
          "allOf": [
            {
              "$ref": "#/$defs/GoldenGate"
            }
          ],
          "description": "prevents stealth edits to committed golden/test output files without explicit override"
        },
        "ignored-tests": {
          "allOf": [
            {
              "$ref": "#/$defs/IgnoredTestsGate"
            }
          ],
          "description": "tests must not be newly #[ignore]d or skipped without directive"
        },
        "issue-link": {
          "allOf": [
            {
              "$ref": "#/$defs/IssueLinkGate"
            }
          ],
          "description": "PR title or description links a tracking issue (#123, Fixes #123)"
        },
        "manifest-sync": {
          "allOf": [
            {
              "$ref": "#/$defs/ManifestSyncGate"
            }
          ],
          "description": "reconcile git-tracked files against packaging manifest declarations"
        },
        "miri": {
          "allOf": [
            {
              "$ref": "#/$defs/MiriGate"
            }
          ],
          "description": "Miri tiers with zero-tests guard"
        },
        "msrv": {
          "allOf": [
            {
              "$ref": "#/$defs/MsrvGate"
            }
          ],
          "description": "cargo check under the pinned MSRV"
        },
        "pii": {
          "allOf": [
            {
              "$ref": "#/$defs/PiiGate"
            }
          ],
          "description": "no home paths, LAN IPs, or denylisted hostnames in tracked text"
        },
        "pr-checklist": {
          "allOf": [
            {
              "$ref": "#/$defs/PrChecklistGate"
            }
          ],
          "description": "ticked PR checkboxes are reconciled against the diff"
        },
        "provenance-tags": {
          "allOf": [
            {
              "$ref": "#/$defs/ProvenanceTagsGate"
            }
          ],
          "description": "published numerics carry (measured|target|projected)"
        },
        "sanitizers": {
          "allOf": [
            {
              "$ref": "#/$defs/SanitizersGate"
            }
          ],
          "description": "ASan / TSan preset with audited suppressions and a race canary"
        },
        "scope-confinement": {
          "allOf": [
            {
              "$ref": "#/$defs/ScopeConfinementGate"
            }
          ],
          "description": "changes stay inside authorized paths"
        },
        "shell-secrets": {
          "allOf": [
            {
              "$ref": "#/$defs/ShellSecretsGate"
            }
          ],
          "description": "no command-line secrets or unverified piped scripts in shell, docker, or CI"
        },
        "suppression-delta": {
          "allOf": [
            {
              "$ref": "#/$defs/SuppressionDeltaGate"
            }
          ],
          "description": "new #[allow], commented-out tests, cfg-gated tests"
        },
        "test-budget": {
          "allOf": [
            {
              "$ref": "#/$defs/TestBudgetGate"
            }
          ],
          "description": "property-test and fuzz effort ratchet (cases, shrink iters, fuzztime, seed corpus)"
        },
        "test-floor": {
          "allOf": [
            {
              "$ref": "#/$defs/TestFloorGate"
            }
          ],
          "description": "test-count ratchet read from the base ref"
        },
        "time-estimates": {
          "allOf": [
            {
              "$ref": "#/$defs/TimeEstimateGate"
            }
          ],
          "description": "no calendar / duration estimates in markdown or the PR body"
        },
        "unsafe-budget": {
          "allOf": [
            {
              "$ref": "#/$defs/UnsafeBudgetGate"
            }
          ],
          "description": "unsafe count ratchet"
        },
        "unsafe-safety-comment": {
          "allOf": [
            {
              "$ref": "#/$defs/UnsafeSafetyCommentGate"
            }
          ],
          "description": "unsafe blocks / impls carry a // SAFETY: comment"
        },
        "vacuous-tests": {
          "allOf": [
            {
              "$ref": "#/$defs/AssertionGate"
            }
          ],
          "description": "new tests must carry a non-tautological assertion"
        },
        "version-lockstep": {
          "allOf": [
            {
              "$ref": "#/$defs/VersionLockstepGate"
            }
          ],
          "description": "version declarations across headers, manifests, and files must remain in lockstep"
        }
      },
      "type": "object"
    },
    "meta": {
      "additionalProperties": false,
      "description": "Repository metadata and configuration format version",
      "properties": {
        "description": {
          "description": "Optional short description of the project",
          "type": "string"
        },
        "mode": {
          "default": "enforcing",
          "description": "Operating mode: 'enforcing' exits non-zero on violations; 'advisory' runs all checks and emits reports but exits 0.",
          "enum": [
            "enforcing",
            "advisory"
          ],
          "type": "string"
        },
        "name": {
          "description": "Repository or project name",
          "type": "string"
        },
        "version": {
          "const": 1,
          "description": "Configuration schema version (must be 1)",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "name"
      ],
      "type": "object"
    }
  },
  "required": [
    "meta"
  ],
  "title": "DisciplineConfig",
  "type": "object"
}
