{
  "$defs": {
    "CouldNotCheck": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "description": "The error, as printed on stderr",
          "type": "string"
        },
        "gate": {
          "description": "The gate that could not run, when one did",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "What stopped the check. A new kind of failure may get a new reason in a minor release; a failure that has one keeps it",
          "enum": [
            "configuration",
            "baseline",
            "repository",
            "tool-missing",
            "tool-timeout",
            "toolchain-unavailable",
            "forge",
            "gate",
            "internal"
          ]
        }
      },
      "required": [
        "reason",
        "gate",
        "detail"
      ],
      "type": "object"
    },
    "GateOutcome": {
      "additionalProperties": false,
      "properties": {
        "baselined": {
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "examined": {
          "description": "Items the gate inspected",
          "minimum": 0,
          "type": "integer"
        },
        "gate": {
          "description": "Stable kebab-case gate id",
          "type": "string"
        },
        "inline_exemptions": {
          "minimum": 0,
          "type": "integer"
        },
        "notes": {
          "description": "What the gate could not verify, and other context",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "overrides": {
          "items": {
            "$ref": "#/$defs/Override"
          },
          "type": "array"
        },
        "suite": {
          "description": "The suite the gate belongs to",
          "type": "string"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "type": "array"
        }
      },
      "required": [
        "gate",
        "suite",
        "enabled",
        "examined",
        "inline_exemptions",
        "baselined",
        "notes",
        "violations",
        "overrides"
      ],
      "type": "object"
    },
    "HookContext": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "description": "The agent whose hook ran the check (`claude-code`, `copilot`, ...)",
          "type": "string"
        },
        "binary_version": {
          "description": "The version of the discipline binary that ran the check",
          "type": "string"
        },
        "decision": {
          "description": "`allowed` when the report passes, otherwise `blocked` (enforce) or `observed` (observe). The hook log (`discipline hook log`) records each run's decision, an end-of-turn refusal included",
          "enum": [
            "allowed",
            "blocked",
            "observed"
          ]
        },
        "event": {
          "description": "`edit` after an edit, `stop` at the end of a turn",
          "enum": [
            "edit",
            "stop"
          ]
        },
        "mode": {
          "description": "`observe` never blocks and logs what it would have blocked; `enforce` blocks",
          "enum": [
            "observe",
            "enforce"
          ]
        }
      },
      "required": [
        "agent",
        "event",
        "mode",
        "binary_version",
        "decision"
      ],
      "type": "object"
    },
    "Override": {
      "additionalProperties": false,
      "properties": {
        "already_in_tree": {
          "description": "An inline marker on a line the change neither adds nor modifies: applied, and not counted by `fail_on_overrides` or `max_inline_overrides`. Present only when true",
          "type": "boolean"
        },
        "code": {
          "description": "The finding the override lifted (`gate/code`, as a violation's `code`): what the run would have reported without the directive. Absent in reports written before it was recorded",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
          "type": "string"
        },
        "directive": {
          "type": "string"
        },
        "gate": {
          "type": "string"
        },
        "hidden": {
          "description": "The directive was inside an HTML comment",
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/OverrideSource"
        },
        "subject": {
          "description": "What the directive names: a test, path, rule, dependency, ...",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "subject",
        "directive",
        "reason",
        "source",
        "hidden"
      ],
      "type": "object"
    },
    "OverrideSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "PrBody"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "detail": {
              "description": "Commit id",
              "type": "string"
            },
            "type": {
              "const": "Commit"
            }
          },
          "required": [
            "type",
            "detail"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "detail": {
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string"
                },
                "line": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "file",
                "line"
              ],
              "type": "object"
            },
            "type": {
              "const": "Inline"
            }
          },
          "required": [
            "type",
            "detail"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "detail": {
              "description": "Pull request number",
              "minimum": 1,
              "type": "integer"
            },
            "type": {
              "const": "MergedPrBody"
            }
          },
          "required": [
            "type",
            "detail"
          ],
          "type": "object"
        }
      ]
    },
    "ReviewRouting": {
      "additionalProperties": false,
      "description": "Unstable until 1.0. Two halves: `deterministic` is exact, and automated routing may condition on it only with a repository's opt-in (a zero is not a clearance); `heuristic` is non-exhaustive and informs reviewers only",
      "properties": {
        "coverage": {
          "additionalProperties": false,
          "properties": {
            "changed_files": {
              "description": "Files the change adds, modifies or renames",
              "minimum": 0,
              "type": "integer"
            },
            "inventoried_files": {
              "description": "Of those, files in a language with a capability inventory that parsed",
              "minimum": 0,
              "type": "integer"
            },
            "languages": {
              "description": "The languages with a capability inventory in this binary",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "unparsed_files": {
              "description": "Files in such a language that did not parse",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "changed_files",
            "inventoried_files",
            "unparsed_files",
            "languages"
          ],
          "type": "object"
        },
        "deterministic": {
          "additionalProperties": false,
          "properties": {
            "authority_files": {
              "description": "Changed files that govern how the change is built, checked or run, in path order",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "change": {
                    "enum": [
                      "added",
                      "modified",
                      "deleted",
                      "renamed"
                    ]
                  },
                  "path": {
                    "type": "string"
                  },
                  "surface": {
                    "enum": [
                      "policy",
                      "ci",
                      "lockfile",
                      "build-hook",
                      "code-owners",
                      "agent-instructions",
                      "toolchain",
                      "sandbox"
                    ]
                  }
                },
                "required": [
                  "path",
                  "surface",
                  "change"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "directive_kinds": {
              "description": "Their names, lower case, each once, sorted",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "directives": {
              "description": "Directives the run read from the change, whether or not they lifted anything",
              "minimum": 0,
              "type": "integer"
            },
            "inline_markers_added": {
              "description": "`discipline:allow(<gate>)` markers on lines the change adds",
              "minimum": 0,
              "type": "integer"
            },
            "inline_markers_removed": {
              "description": "Marker lines the base side had that the head side does not",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "directives",
            "directive_kinds",
            "inline_markers_added",
            "inline_markers_removed",
            "authority_files"
          ],
          "type": "object"
        },
        "heuristic": {
          "additionalProperties": false,
          "properties": {
            "capability_sites": {
              "description": "Calls to a capability sink on lines the change adds, from a closed vocabulary per language: non-exhaustive",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "line": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "surface": {
                    "enum": [
                      "process-spawn",
                      "dynamic-eval",
                      "network"
                    ]
                  }
                },
                "required": [
                  "file",
                  "line",
                  "surface"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "tests_added": {
              "description": "Tests the head side has that the base side does not, by name",
              "minimum": 0,
              "type": "integer"
            },
            "tests_removed": {
              "description": "Tests the base side has that the head side does not, by name",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "capability_sites",
            "tests_added",
            "tests_removed"
          ],
          "type": "object"
        },
        "stability": {
          "description": "The section's stability statement",
          "type": "string"
        }
      },
      "required": [
        "stability",
        "deterministic",
        "heuristic",
        "coverage"
      ],
      "type": "object"
    },
    "UnusedDirective": {
      "additionalProperties": false,
      "properties": {
        "directive": {
          "type": "string"
        },
        "hidden": {
          "description": "The directive was inside an HTML comment",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/OverrideSource"
        }
      },
      "required": [
        "directive",
        "source",
        "hidden"
      ],
      "type": "object"
    },
    "Violation": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "`gate/code`: the finding's stable identity, frozen from 1.0 (the registry in `src/findings.rs`)",
          "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
          "type": "string"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "fingerprint": {
          "description": "The baseline fingerprint (version 2: sha256 of code, path and the source line or message), stable across line moves and title changes",
          "pattern": "^([0-9a-f]{64})?$",
          "type": "string"
        },
        "gate": {
          "type": "string"
        },
        "line": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "remediation": {
          "type": [
            "string",
            "null"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "note"
          ]
        },
        "title": {
          "description": "Display text, free to change",
          "type": "string"
        }
      },
      "required": [
        "gate",
        "code",
        "fingerprint",
        "severity",
        "title",
        "file",
        "line",
        "message",
        "remediation"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The report `discipline check --format json` prints on stdout and `--json-out` writes. Exit 0 means no finding blocks, 1 that one does, 2 that the check could not run: then the report has no outcomes and `could_not_check` says why.",
  "properties": {
    "base": {
      "description": "The ref the change was measured against, as resolved (e.g. `origin/main (merge base 1a2b3c4d5e)`)",
      "type": "string"
    },
    "baselined": {
      "description": "Findings suppressed by the baseline file",
      "minimum": 0,
      "type": "integer"
    },
    "could_not_check": {
      "$ref": "#/$defs/CouldNotCheck",
      "description": "Why the check could not run (exit 2). Omitted otherwise"
    },
    "deprecations": {
      "description": "Deprecated configuration keys this run read, one note each; never fails the run. Omitted when empty",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "directive_notes": {
      "description": "Notes about the directive sources as a whole (the merged pull request a pushed commit came through, a forge lookup that could not be made), once per run; a note about one directive is in its gate's notes. Omitted when empty",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "errors": {
      "description": "Findings of severity `error` across all gates",
      "minimum": 0,
      "type": "integer"
    },
    "hook": {
      "$ref": "#/$defs/HookContext",
      "description": "The agent hook that ran this check, and what it answers on this report. Omitted when no hook ran the check"
    },
    "notes": {
      "description": "Findings of severity `note`",
      "minimum": 0,
      "type": "integer"
    },
    "outcomes": {
      "description": "One entry per gate, in registry order",
      "items": {
        "$ref": "#/$defs/GateOutcome"
      },
      "type": "array"
    },
    "overrides": {
      "description": "Directive overrides applied across all gates",
      "minimum": 0,
      "type": "integer"
    },
    "planned_gates": {
      "description": "Gate ids the roadmap plans but this binary does not ship",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "policy_failures": {
      "description": "Run-level refusals no single gate owns; any entry fails the run. Omitted when empty",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "review_routing": {
      "$ref": "#/$defs/ReviewRouting",
      "description": "UNSTABLE until 1.0: names and shape may change in any release, and none is in the frozen interface. What the change touches that a reviewer routes on: an inventory, never a verdict. Omitted when the run has no change to describe"
    },
    "schema_version": {
      "const": 1,
      "description": "This schema's version: a field added keeps it, one renamed, removed or retyped raises it"
    },
    "stale_baseline_entries": {
      "description": "Baseline entries no finding of this run matched (resolved findings), a disabled gate's included; `discipline baseline --write` drops them. Omitted when there are none",
      "minimum": 1,
      "type": "integer"
    },
    "unused_directives": {
      "description": "Directives this run read that lifted no finding; never fails the run. Computed when every suite ran. Omitted when empty",
      "items": {
        "$ref": "#/$defs/UnusedDirective"
      },
      "type": "array"
    },
    "warnings": {
      "description": "Findings of severity `warning`",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "base",
    "errors",
    "warnings",
    "notes",
    "overrides",
    "baselined",
    "outcomes",
    "planned_gates"
  ],
  "title": "DisciplineReport",
  "type": "object"
}
