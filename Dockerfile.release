# syntax=docker/dockerfile:1
# Minimal OCI container image for discipline: universal CI/CD sentinel and AI agent diff guard.
# Packaged with statically linked musl binary and git for containerized CI execution.

# Pinned by digest so a rebuild of a tag uses the same base; bump deliberately.
FROM alpine:3.21@sha256:ee16d92f96db08d9d2d07da48555a27f3a69d8f0759021dbc601195ed0d2b5bd

# Install CA certificates for secure checkouts and git for local repository operations
# Configure system-wide safe.directory = '/workspace' while still root before switching to unprivileged user
RUN apk add --no-cache ca-certificates git \
    && addgroup -g 10001 -S discipline \
    && adduser -u 10001 -S -G discipline -h /var/lib/discipline -s /bin/sh discipline \
    && mkdir -p /workspace /var/lib/discipline \
    && chown -R discipline:discipline /workspace /var/lib/discipline \
    && git config --system --add safe.directory /workspace

# Multi-arch static binary placement (populated from release artifacts) and entrypoint wrapper
ARG TARGETARCH
COPY bin-${TARGETARCH}/discipline /usr/local/bin/discipline
COPY packaging/docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/discipline /usr/local/bin/docker-entrypoint.sh

# Use unprivileged non-root user (numeric UID:GID for strict container security policies)
USER 10001:10001
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["check"]
